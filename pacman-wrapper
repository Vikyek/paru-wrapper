#!/bin/bash
# Check if we are running in a wrapper transaction
if [ -n "$SUDO_USER" ]; then
    # When running under sudo (e.g. as root), use the calling user's cache dir
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [ -n "$USER_HOME" ]; then
        CACHE_DIR="$USER_HOME/.cache/paru-wrapper"
    fi
else
    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        CACHE_DIR="${XDG_CACHE_HOME}/paru-wrapper"
    elif [ -n "${HOME:-}" ]; then
        CACHE_DIR="${HOME}/.cache/paru-wrapper"
    fi
fi

if [ -n "${CACHE_DIR:-}" ] && [ -f "$CACHE_DIR/paru_total_packages" ] && [ -f "$CACHE_DIR/paru_completed_packages" ]; then
    # We only increment progress for install or upgrade commands
    is_install=false
    for arg in "$@"; do
        if [[ "$arg" =~ ^-U[a-zA-Z]*$ ]] || [[ "$arg" =~ ^-S[a-zA-Z]*$ ]]; then
            is_install=true
            break
        fi
    done

    if [ "$is_install" = true ]; then
        total=$(cat "$CACHE_DIR/paru_total_packages" 2>/dev/null || echo "0")
        completed=$(cat "$CACHE_DIR/paru_completed_packages" 2>/dev/null || echo "0")

        # Strictly validate variables to prevent bash arithmetic command injection
        if [[ ! "$total" =~ ^[0-9]+$ ]]; then total=0; fi
        if [[ ! "$completed" =~ ^[0-9]+$ ]]; then completed=0; fi

        if [ "$total" -gt 0 ]; then
            completed=$((completed + 1))

            echo "$completed" | sudo -u "$SUDO_USER" tee "$CACHE_DIR/paru_completed_packages" > /dev/null 2>&1 || true
            if [ -z "$SUDO_USER" ] && [ ! -L "$CACHE_DIR/paru_completed_packages" ]; then
                echo "$completed" > "$CACHE_DIR/paru_completed_packages" 2>/dev/null || true
            fi

            percent=$((completed * 100 / total))

            bar_len=20
            filled=$((percent * bar_len / 100))
            bar_full="####################"
            bar_empty="--------------------"
            bar="[${bar_full:0:filled}${bar_empty:0:bar_len-filled}]"

            if [ -z "${NO_COLOR:-}" ]; then
                echo -e "\n\e[1;32m[paru-wrapper] Progress: $completed / $total packages completed ($percent%) $bar\e[0m\n" >&2
            else
                echo -e "\n[paru-wrapper] Progress: $completed / $total packages completed ($percent%) $bar\n" >&2
            fi
        fi
    fi
fi

# Execute the real pacman
exec /usr/bin/pacman "$@"
