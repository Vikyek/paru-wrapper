#!/bin/bash
# Check if we are running in a wrapper transaction
if [ -n "$SUDO_USER" ]; then
    # When running under sudo (e.g. as root), use the calling user's cache dir
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [ -n "$USER_HOME" ]; then
        CACHE_DIR="$USER_HOME/.cache/paru-wrapper"
    fi
else
    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        CACHE_DIR="${XDG_CACHE_HOME}/paru-wrapper"
    elif [ -n "${HOME:-}" ]; then
        CACHE_DIR="${HOME}/.cache/paru-wrapper"
    fi
fi

if [ -n "${CACHE_DIR:-}" ] && [ -f "$CACHE_DIR/paru_total_packages" ] && [ -f "$CACHE_DIR/paru_completed_packages" ]; then
    # We only increment progress for install or upgrade commands
    is_install=false
    for arg in "$@"; do
        if [[ "$arg" =~ ^-U[a-zA-Z]*$ ]] || [[ "$arg" =~ ^-S[a-zA-Z]*$ ]]; then
            is_install=true
            break
        fi
    done

    if [ "$is_install" = true ]; then
        total=$(cat "$CACHE_DIR/paru_total_packages" 2>/dev/null || echo "0")
        completed=$(cat "$CACHE_DIR/paru_completed_packages" 2>/dev/null || echo "0")
        if [ "$total" -gt 0 ]; then
            completed=$((completed + 1))
            echo "$completed" > "$CACHE_DIR/paru_completed_packages"
            percent=$((completed * 100 / total))

            if [ -z "${NO_COLOR:-}" ]; then
                c_green='\e[1;32m'
                c_reset='\e[0m'
            else
                c_green=''
                c_reset=''
            fi

            bar_len=20
            filled=$((percent * bar_len / 100))
            empty=$((bar_len - filled))

            filled_str="##################################################"
            empty_str="--------------------------------------------------"
            bar="${filled_str:0:filled}"
            bar_empty="${empty_str:0:empty}"

            echo -e "\n${c_green}[paru-wrapper] Progress: [${bar}${bar_empty}] $completed / $total packages (${percent}%)${c_reset}\n" >&2
        fi
    fi
fi

# Execute the real pacman
exec /usr/bin/pacman "$@"
