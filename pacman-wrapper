#!/bin/bash
# Check if we are running in a wrapper transaction
if [ -n "$SUDO_USER" ]; then
    # When running under sudo (e.g. as root), use the calling user's cache dir
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    if [ -n "$USER_HOME" ]; then
        CACHE_DIR="$USER_HOME/.cache/paru-wrapper"
    fi
else
    if [ -n "${XDG_CACHE_HOME:-}" ]; then
        CACHE_DIR="${XDG_CACHE_HOME}/paru-wrapper"
    elif [ -n "${HOME:-}" ]; then
        CACHE_DIR="${HOME}/.cache/paru-wrapper"
    fi
fi

if [ -n "${CACHE_DIR:-}" ] && [ -f "$CACHE_DIR/paru_total_packages" ] && [ -f "$CACHE_DIR/paru_completed_packages" ]; then
    # We only increment progress for install or upgrade commands
    is_install=false
    for arg in "$@"; do
        if [[ "$arg" =~ ^-U[a-zA-Z]*$ ]] || [[ "$arg" =~ ^-S[a-zA-Z]*$ ]]; then
            is_install=true
            break
        fi
    done

    if [ "$is_install" = true ]; then
        total=$(cat "$CACHE_DIR/paru_total_packages" 2>/dev/null || echo "0")
        completed=$(cat "$CACHE_DIR/paru_completed_packages" 2>/dev/null || echo "0")

        # Sanitize variables to prevent bash arithmetic command injection
        total="${total//[^0-9]/}"
        completed="${completed//[^0-9]/}"
        total="${total:-0}"
        completed="${completed:-0}"

        if [ "$total" -gt 0 ]; then
            completed=$((completed + 1))

            # Prevent symlink attacks by dropping privileges when writing to user cache dir
            if [ -n "$SUDO_USER" ] && command -v sudo >/dev/null; then
                sudo -u "$SUDO_USER" bash -c "echo '$completed' > '$CACHE_DIR/paru_completed_packages'" 2>/dev/null || true
            else
                if [ ! -L "$CACHE_DIR/paru_completed_packages" ]; then
                    echo "$completed" > "$CACHE_DIR/paru_completed_packages" 2>/dev/null || true
                fi
            fi

            percent=$((completed * 100 / total))
            echo -e "\n\e[1;32m[paru-wrapper] Progress: $completed / $total packages completed ($percent%)\e[0m\n" >&2
        fi
    fi
fi

# Execute the real pacman
exec /usr/bin/pacman "$@"
