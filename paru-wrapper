#!/bin/bash

# paru-wrapper - wrapper around paru to handle dependency-aware orphan cleaning
# and automatic local repository DB updates.
#
# Usage:
#  /usr/bin/paru-wrapper [--dry-run] [--low-priority|--no-low-priority] <paru args...>
#  /usr/bin/paru-wrapper --init-repo <repo_name> <repo_dir> <projects_dir>
#  /usr/bin/paru-wrapper --connect-repo <repo_name> <repo_dir> <projects_dir>

set -euo pipefail

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
# Intercept wrapper-specific help
if [[ "${1:-}" == "--wrapper-help" ]]; then
    cat << 'EOF'
paru-wrapper - Custom paru wrapper providing automatic local AUR repository
management, modular plugin hooks, and --gittinator VCS migrations.

Usage:
    paru-wrapper [options] <paru arguments...>
    paru-wrapper --init-repo <repo_name> <repo_dir> <projects_dir>
    paru-wrapper --connect-repo <repo_name> <repo_dir> <projects_dir>
    paru-wrapper --wrapper-help
    paru-wrapper --wrapper-version

Wrapper Options:
    --gittinator            Scan installed AUR packages and migrate to -git variants
    --low-priority          Run paru/makepkg builds with low CPU/IO priority (default)
    --no-low-priority       Disable low-priority CPU/IO throttling for this run
    --no-batch              Install FORCE_REBUILD packages individually instead of batched pacman -U
    --cleanup-builddeps     Allow orphan cleanup to remove build-deps and toolchains
    --no-cleanup-builddeps  Preserve build-deps and toolchains during orphan cleanup (default)
    --init-repo             Initialize an empty custom local pacman repository
    --connect-repo          Connect to an existing custom local pacman repository
    --wrapper-help          Display this paru-wrapper extended help message
    --wrapper-version       Display paru-wrapper version string

Modular Plugins:
    Hook directories:
      - System: /usr/lib/paru-wrapper/plugins.d/
      - Global: /etc/paru-wrapper/plugins.d/
      - User:   ~/.config/paru-wrapper/plugins.d/

    Default plugins:
      10-snapper.sh         Pre/post btrfs snapshots (requires snapper)
      20-anneal.sh          Rebuild queue unmarking (requires anneal)
      25-projects-pull.sh   Pre-transaction git pull and auto-install for Projects packages
      30-rebuild-check.sh   Post-upgrade rebuild detection (rebuild-check-hook)
      40-paru-completion.sh Shell completion cache updates (paru-completion-hook)
      50-vault-sync.sh      Background private config sync pass

Environment Variables:
    PARU_WRAPPER_REPO                       Custom local repository name (e.g. MYREPO)
    PARU_WRAPPER_REPO_DIR                   Directory containing custom repository .db
    PARU_WRAPPER_PROJECTS_DIR               Root path to local package projects (~/Projects)
    PARU_WRAPPER_AUTO_UPDATE_INSTALLED      Auto-upgrade AUR repo and updated Projects packages (default: true)
    PARU_WRAPPER_LOW_PRIORITY               Run paru/makepkg with low CPU/IO priority (default: true)
    PARU_WRAPPER_CLEANUP_BUILDDEPS          Remove build-dep/toolchain orphans when set to 1 (default: 0)
    PARU_WRAPPER_BATCH_INSTALL              Batch FORCE_REBUILD installs into one pacman -U call (default: 1)
    PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER Auto-accept non-critical verify_pkg warnings when 1/true (default: 0)
    PARU_WRAPPER_DRY_RUN                    Simulate operations without executing (default: false)
    PARU_WRAPPER_NET_RETRY_MAX              Max network-drop / partial-download resume retries (default: 5)
    PARU_WRAPPER_NET_WAIT_TIMEOUT           Seconds to wait for network recovery (default: 1800, 0 disables)
    PARU_WRAPPER_NET_CHECK_URL              URL probed for connectivity recovery (default: https://archlinux.org)
    PARU_WRAPPER_BUILD_USER                 Non-root build user when invoked as root (auto-detected)
    PARU_WRAPPER_SRCDEST                    Override makepkg SRCDEST for stale git clone recovery
    FORCE_REBUILD                           Rebuild package from source (default: 0)

All other arguments and flags are passed directly to upstream paru.
See 'man paru-wrapper' or 'paru --help' for upstream pacman/paru options.
EOF
    exit 0
fi

# Intercept wrapper-specific version query
if [[ "${1:-}" == "--wrapper-version" ]]; then
    echo "paru-wrapper 1.2.0"
    exit 0
fi

# Dispatch the custom Gittinator mode before normal paru processing.
for arg in "$@"; do
    if [[ "$arg" == "--gittinator" ]]; then
        gittinator_helper="/usr/lib/paru-wrapper/paru-wrapper-gittinator"

        if [[ ! -x "$gittinator_helper" ]]; then
            local_helper="$(dirname "$(readlink -f "$0")")/paru-wrapper-gittinator"

            if [[ -x "$local_helper" ]]; then
                gittinator_helper="$local_helper"
            else
                echo "[paru-wrapper] Error: Gittinator helper is not installed." >&2
                exit 1
            fi
        fi

        exec "$gittinator_helper" "$@"
    fi
done
fi

if [ -z "${NO_COLOR:-}" ] && [ -t 2 ]; then
    C_INFO='\e[1;34m'
    C_WARN='\e[1;33m'

    C_RESET='\e[0m'
else
    C_INFO=''
    C_WARN=''

    C_RESET=''
fi

msg_info() { echo -e "${C_INFO}[paru-wrapper]${C_RESET} $*" >&2; }
msg_warn() { echo -e "${C_WARN}[paru-wrapper] Warning:${C_RESET} $*" >&2; }

_PW_INVOKING_USER=""
_PW_INVOKING_HOME="${HOME:-}"
_resolve_invoking_user() {
    if [ "$(id -u)" -ne 0 ]; then
        return 0
    fi
    local candidate=""
    if [ -n "${PARU_WRAPPER_BUILD_USER:-}" ] && [ "$PARU_WRAPPER_BUILD_USER" != "root" ]; then
        candidate="$PARU_WRAPPER_BUILD_USER"
    elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        candidate="$SUDO_USER"
    elif [ -n "${PKEXEC_UID:-}" ]; then
        candidate=$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1 || true)
    fi
    if [ -z "$candidate" ] || [ "$candidate" = "root" ] || ! id -u "$candidate" >/dev/null 2>&1; then
        candidate=""
        if command -v loginctl >/dev/null 2>&1; then
            candidate=$(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 && $3 == "active" { print $2; exit }' || true)
            if [ -z "$candidate" ]; then
                candidate=$(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 { print $2; exit }' || true)
            fi
        fi
    fi
    if [ -n "$candidate" ] && [ "$candidate" != "root" ] && id -u "$candidate" >/dev/null 2>&1; then
        _PW_INVOKING_USER="$candidate"
        _PW_INVOKING_HOME=$(getent passwd "$candidate" 2>/dev/null | cut -d: -f6 || true)
    fi
}
_resolve_invoking_user

run_as_build_user() {
    if [ "$(id -u)" -eq 0 ] && [ -n "${_PW_INVOKING_USER:-}" ]; then
        runuser -u "$_PW_INVOKING_USER" -- env -u XDG_CONFIG_HOME -u XDG_CACHE_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME "$@"
    else
        "$@"
    fi
}

_is_truthy() {
    case "${1:-}" in
        true|1|yes|on|TRUE|YES|ON) return 0 ;;
        *) return 1 ;;
    esac
}

_is_low_priority_enabled() {
    _is_truthy "${LOW_PRIORITY:-${PARU_WRAPPER_LOW_PRIORITY:-true}}"
}

_is_cleanup_builddeps_enabled() {
    _is_truthy "${CLEANUP_BUILDDEPS:-${PARU_WRAPPER_CLEANUP_BUILDDEPS:-0}}"
}

_is_batch_install_enabled() {
    _is_truthy "${BATCH_INSTALL:-${PARU_WRAPPER_BATCH_INSTALL:-1}}"
}

run_low_priority() {
    if ! _is_low_priority_enabled; then
        "$@"
        return $?
    fi

    local nice_cmd=()
    if command -v nice >/dev/null 2>&1; then
        nice_cmd=(nice -n 15)
    fi
    if command -v ionice >/dev/null 2>&1; then
        nice_cmd+=(ionice -c 3)
    fi
    if [[ ${#nice_cmd[@]} -gt 0 ]]; then
        nice_cmd+=(--)
    fi

    if [[ ${EUID:-$(id -u)} -ne 0 ]] && command -v systemd-run >/dev/null 2>&1 && systemd-run --user --scope -q true >/dev/null 2>&1; then
        systemd-run --user --scope -q -p CPUWeight=20 -p IOWeight=20 -- "${nice_cmd[@]}" "$@"
    elif [[ ${#nice_cmd[@]} -gt 0 ]]; then
        "${nice_cmd[@]}" "$@"
    else
        "$@"
    fi
}

_run_build_cmd() {
    if [ "$(id -u)" -eq 0 ] && [ -n "${_PW_INVOKING_USER:-}" ]; then
        run_low_priority runuser -u "$_PW_INVOKING_USER" -- env -u XDG_CONFIG_HOME -u XDG_CACHE_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME "$@"
    else
        run_low_priority "$@"
    fi
}

run_as_repo_owner() {
    if [ "$(id -u)" -eq 0 ]; then
        local owner=""
        if [ -n "${PARU_WRAPPER_REPO_DB:-}" ] && [ -e "$PARU_WRAPPER_REPO_DB" ]; then
            owner=$(stat -c '%U' "$PARU_WRAPPER_REPO_DB" 2>/dev/null || true)
        fi
        if [ -z "$owner" ] || [ "$owner" = "root" ] || [ "$owner" = "UNKNOWN" ]; then
            owner="${_PW_INVOKING_USER:-}"
        fi
        if [ -n "$owner" ] && [ "$owner" != "root" ] && id -u "$owner" >/dev/null 2>&1; then
            runuser -u "$owner" -- env -u XDG_CONFIG_HOME -u XDG_CACHE_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME "$@"
            return $?
        fi
    fi
    "$@"
}

# Plugin Hook Dispatcher
# Plugins are located in:
#  - User overrides: $XDG_CONFIG_HOME/paru-wrapper/plugins.d or ~/.config/paru-wrapper/plugins.d
#  - System config:  /etc/paru-wrapper/plugins.d
#  - System plugins: /usr/lib/paru-wrapper/plugins.d
#  - Local fallback: $(dirname $0)/default-plugins
dispatch_plugin_hooks() {
    local event="$1"
    shift
    local plugin_dirs=()

    if [ -n "${XDG_CONFIG_HOME:-}" ] && [ -d "${XDG_CONFIG_HOME}/paru-wrapper/plugins.d" ]; then
        plugin_dirs+=("${XDG_CONFIG_HOME}/paru-wrapper/plugins.d")
    elif [ -n "${HOME:-}" ] && [ -d "${HOME}/.config/paru-wrapper/plugins.d" ]; then
        plugin_dirs+=("${HOME}/.config/paru-wrapper/plugins.d")
    fi
    if [ "$(id -u)" -eq 0 ] && [ -n "${_PW_INVOKING_HOME:-}" ] && [ "$_PW_INVOKING_HOME" != "${HOME:-}" ] && [ -d "${_PW_INVOKING_HOME}/.config/paru-wrapper/plugins.d" ]; then
        plugin_dirs+=("${_PW_INVOKING_HOME}/.config/paru-wrapper/plugins.d")
    fi

    if [ -d "/etc/paru-wrapper/plugins.d" ]; then
        plugin_dirs+=("/etc/paru-wrapper/plugins.d")
    fi

    if [ -d "/usr/lib/paru-wrapper/plugins.d" ]; then
        plugin_dirs+=("/usr/lib/paru-wrapper/plugins.d")
    fi

    local local_dir
    local_dir="$(dirname "$(readlink -f "$0")")/default-plugins"
    if [ -d "$local_dir" ]; then
        plugin_dirs+=("$local_dir")
    fi

    declare -A executed_plugins=()
    for dir in "${plugin_dirs[@]}"; do
        for plugin in "$dir"/*.sh; do
            [ -f "$plugin" ] || continue
            local p_name
            p_name=$(basename "$plugin")
            [ -n "${executed_plugins[$p_name]:-}" ] && continue
            executed_plugins["$p_name"]=1

            (
                # Run hook in subshell to avoid polluting global state
                # shellcheck disable=SC1090
                source "$plugin"
                if declare -F plugin_hook >/dev/null; then
                    plugin_hook "$event" "$@"
                fi
            ) || true
        done
    done
}


declare -gA _aur_pkgs_cache=()
declare -gA _aur_pkgbase_cache=()
declare -gA _aur_makedepends_cache=()
declare -gA _aur_rpc_failed_pkgs=()
declare -g _aur_rpc_failed=0
declare -gA _built_split_files=()
declare -gA _blocked_pkgbases=()
declare -g _LAST_BUILT_PKG_FILE=""

# Parse AUR RPC v5 JSON into global metadata caches.
_parse_aur_rpc_payload() {
    local payload="$1"
    jq -e '(.type // "") != "error" and (.results | type == "array")' >/dev/null 2>&1 <<< "$payload" || return 1
    eval "$(printf '%s' "$payload" | jq -r '
        .results[]? | select(.Name != null and .Name != "") |
        "_aur_pkgs_cache[\(.Name | @sh)]=\(.Version | @sh)\n" +
        "_aur_pkgbase_cache[\(.Name | @sh)]=\((.PackageBase // .Name) | @sh)\n" +
        "_aur_makedepends_cache[\(.Name | @sh)]=\((((.Depends // []) + (.MakeDepends // []) + (.CheckDepends // [])) | map(sub("[<>=].*$"; "")) | unique | join(" ")) | @sh)"
    ' 2>/dev/null)"
}

# Resolves the AUR package metadata in batched chunks with retry and outage tracking.
#
# @param $@ - List of package names to query
# @returns Populates _aur_pkgs_cache, _aur_pkgbase_cache, _aur_makedepends_cache,
#          and sets _aur_rpc_failed=1 / _aur_rpc_failed_pkgs[pkg]=1 on failure.
fetch_aur_metadata_batch() {
    local pkgs=("$@")
    local chunk_size=50
    local i chunk query_args curl_out curl_rc pkg
    local max_retries="${PARU_WRAPPER_NET_RETRY_MAX:-5}"
    local retry_delay="${PARU_WRAPPER_RETRY_DELAY:-2}"

    _aur_rpc_failed=0
    [[ ${#pkgs[@]} -eq 0 ]] && return 0

    for ((i = 0; i < ${#pkgs[@]}; i += chunk_size)); do
        chunk=("${pkgs[@]:i:chunk_size}")
        query_args=()

        for pkg in "${chunk[@]}"; do
            query_args+=(--data-urlencode "arg[]=$pkg")
        done

        local attempt=0 chunk_ok=false
        while true; do
            curl_out=""
            curl_rc=0
            curl_out=$(curl -s -f -G --connect-timeout 10 --max-time 20 "https://aur.archlinux.org/rpc/v5/info" "${query_args[@]}" 2>/dev/null) || curl_rc=$?

            if [[ $curl_rc -eq 0 ]] && _parse_aur_rpc_payload "$curl_out"; then
                for pkg in "${chunk[@]}"; do
                    unset '_aur_rpc_failed_pkgs["$pkg"]'
                done
                chunk_ok=true
                break
            fi

            if ! is_network_online; then
                msg_warn "Network connectivity unavailable during AUR RPC query. Waiting for network recovery..."
                if wait_for_network && (( attempt < max_retries )); then
                    ((++attempt))
                    continue
                fi
                break
            fi

            if (( attempt < max_retries )); then
                ((++attempt))
                msg_warn "AUR RPC query failed (attempt $attempt/$max_retries). Retrying in ${retry_delay}s..."
                if [[ "$retry_delay" =~ ^[0-9]+$ && "$retry_delay" -gt 0 ]]; then
                    sleep "$retry_delay"
                fi
                continue
            fi
            break
        done

        if [[ "$chunk_ok" != true ]]; then
            _aur_rpc_failed=1
            for pkg in "${chunk[@]}"; do
                _aur_rpc_failed_pkgs["$pkg"]=1
            done
            msg_warn "AUR RPC lookup failed for ${#chunk[@]} package(s) (${chunk[*]}). Network/DNS or RPC error; will not mark packages as missing from AUR."
        fi
    done
    return 0
}

# Build (and optionally install) a cloned AUR package directory, handling split PKGBUILDs safely.
rebuild_cloned_aur_package() {
    local pkg_name="$1"
    local clone_name="$2"
    local build_dir="$3"
    shift 3
    local batch_targets=("$@")

    _LAST_BUILT_PKG_FILE=""
    _preflight_haskell_check "$pkg_name" "$build_dir"

    local pre_pkgfiles=()
    mapfile -t pre_pkgfiles < <(run_as_build_user env -C "$build_dir" makepkg --packagelist 2>/dev/null || true)

    local defer_install=false
    if [[ "${_DEFER_BATCH_INSTALL:-0}" == "1" ]] && _is_batch_install_enabled; then
        defer_install=true
    fi

    # Fallback to immediate -Csfi only when not batching, or when a mock makepkg outputs no --packagelist entries.
    if [[ "$clone_name" == "$pkg_name" && ${#pre_pkgfiles[@]} -le 1 ]] && { [[ "$defer_install" != true ]] || [[ ${#pre_pkgfiles[@]} -eq 0 ]]; }; then
        run_makepkg_with_recovery "$build_dir" -Csfi --noconfirm
        return $?
    fi

    # Build without -i so split subpackages / -dbg archives do not trigger unwanted installs or per-package hook runs.
    run_makepkg_with_recovery "$build_dir" -Csf --noconfirm || return $?

    local built_pkgfiles=()
    mapfile -t built_pkgfiles < <(run_as_build_user env -C "$build_dir" makepkg --packagelist 2>/dev/null || true)

    local -A requested_set=()
    local t
    for t in "${batch_targets[@]}"; do
        requested_set["${t#*/}"]=1
    done

    local target_pkg_file="" f sub_pkg
    for f in "${built_pkgfiles[@]}"; do
        [[ -f "$f" ]] || continue
        sub_pkg=$(pacman -Qp "$f" 2>/dev/null | awk '{print $1}' || true)
        [[ -n "$sub_pkg" ]] || continue
        if [[ "$sub_pkg" == "$pkg_name" ]]; then
            _built_split_files["$sub_pkg"]="$f"
            target_pkg_file="$f"
        elif [[ -n "${requested_set["$sub_pkg"]:-}" ]]; then
            _built_split_files["$sub_pkg"]="$f"
        else
            rm -f "$f" "${f}.sig" 2>/dev/null || true
            unset '_built_split_files["$sub_pkg"]'
        fi
    done

    if [[ -z "$target_pkg_file" || ! -f "$target_pkg_file" ]]; then
        msg_warn "Built package '$clone_name' did not produce a package archive for '$pkg_name'."
        return 1
    fi

    _LAST_BUILT_PKG_FILE="$target_pkg_file"
    if [[ "$defer_install" == true ]]; then
        return 0
    fi

    sudo pacman -U --noconfirm -- "$target_pkg_file"
}

# Verify a cloned AUR build directory with verify_pkg before running makepkg
verify_cloned_aur_dir() {
    local pkg_name="$1"
    local build_dir="$2"
    command -v verify_pkg >/dev/null 2>&1 || return 0

    local verify_json verify_danger=0 verify_verdict="" verify_rec="" verify_rc=0
    local -a verify_fields=()
    verify_json=$(verify_pkg --json "$build_dir" 2>/dev/null) || verify_rc=$?
    if [[ -n "$verify_json" ]]; then
        mapfile -t verify_fields < <(
            printf '%s' "$verify_json" | jq -r '(.danger_score // 0), (.verdict // ""), (.recommended_action // "")' 2>/dev/null || true
        )
        verify_danger="${verify_fields[0]:-0}"
        verify_verdict="${verify_fields[1]:-}"
        verify_rec="${verify_fields[2]:-}"
        [[ "$verify_danger" =~ ^[0-9]+$ ]] || verify_danger=0
    fi

    local verify_allowed=false
    if [[ "$verify_rc" -eq 0 && "$verify_verdict" != "SUSPICIOUS" && "$verify_verdict" != "CRITICAL_RISK" ]]; then
        if [[ "$verify_danger" -eq 0 || "$verify_verdict" == "SAFE_LOCAL_IDIOM" || "$verify_rec" == "ACCEPT" ]]; then
            verify_allowed=true
        fi
    fi

    if [[ "$verify_allowed" != true && "$verify_rc" -eq 0 && "$verify_verdict" != "CRITICAL_RISK" ]]; then
        case "${PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER:-0}" in
            1|true|yes|on|TRUE|YES|ON)
                verify_allowed=true
                msg_warn "Auto-accepting '$pkg_name' (Verdict: ${verify_verdict:-UNKNOWN}, Danger: ${verify_danger}) via PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER."
                ;;
            [0-9]*)
                if [[ "${PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER:-0}" -gt 1 ]] 2>/dev/null && [[ "$verify_danger" -le "${PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER}" ]]; then
                    verify_allowed=true
                    msg_warn "Auto-accepting '$pkg_name' (Danger ${verify_danger} <= ${PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER}) via PARU_WRAPPER_PKGSCAN_AUTO_ACCEPT_DANGER."
                fi
                ;;
        esac
    fi

    if [[ "$verify_allowed" != true ]]; then
        verify_pkg "$build_dir" >&2 || true
        msg_warn "Security verification flagged '$pkg_name' (Verdict: ${verify_verdict:-UNKNOWN}, Danger: ${verify_danger}). Aborting rebuild!"
        return 1
    fi
    return 0
}

# Safely extract git source URL/ref and dependencies from .SRCINFO or PKGBUILD without executing bash.
_extract_pkgbuild_info() {
    local pkg_dir="$1"
    python3 - "$pkg_dir" << 'PYINFO' 2>/dev/null || true
import os, re, shlex, sys

pkg_dir = sys.argv[1]
srcinfo = os.path.join(pkg_dir, ".SRCINFO")
pkgbuild = os.path.join(pkg_dir, "PKGBUILD")

deps = []
sources = []

if os.path.isfile(srcinfo):
    with open(srcinfo, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            s = line.strip()
            if s.startswith(("depends =", "makedepends =", "checkdepends =")):
                _, val = s.split("=", 1)
                dep = re.sub(r"[<>=].*$", "", val.strip())
                if dep:
                    deps.append(dep)
            elif s.startswith("source =") or s.startswith("source_x86_64 ="):
                _, val = s.split("=", 1)
                val = val.strip()
                if val:
                    sources.append(val)

if (not deps or not sources) and os.path.isfile(pkgbuild):
    with open(pkgbuild, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    lines = [ln.split("#", 1)[0] if not ln.lstrip().startswith("#") else "" for ln in text.splitlines()]
    clean = "\n".join(lines)

    vars_map = {}
    for var in ("pkgname", "_pkgname", "pkgbase", "url", "_repo"):
        m_var = re.search(rf'(?m)^\s*{var}\s*=\s*([^\n(]+)', clean)
        if m_var:
            vars_map[var] = m_var.group(1).strip().strip("'\"")

    def expand_vars(val):
        pkgname = vars_map.get("pkgname", "")
        if pkgname:
            val = val.replace("${pkgname%-git}", pkgname[:-4] if pkgname.endswith("-git") else pkgname)
            val = val.replace("${pkgname}", pkgname).replace("$pkgname", pkgname)
        for k, v in vars_map.items():
            val = val.replace(f"${{{k}}}", v).replace(f"${k}", v)
        return val

    def extract_array(key):
        m_arr = re.search(rf'(?m)^\s*{key}\s*=\s*\((.*?)\)', clean, re.S)
        if not m_arr:
            return []
        raw = m_arr.group(1)
        try:
            return shlex.split(raw)
        except ValueError:
            return raw.split()

    if not deps:
        for key in ("depends", "makedepends", "checkdepends"):
            for item in extract_array(key):
                d = re.sub(r"[<>=].*$", "", expand_vars(item).strip("'\""))
                if d and "$" not in d:
                    deps.append(d)

    if not sources:
        for key in ("source", "source_x86_64"):
            for item in extract_array(key):
                s_val = expand_vars(item).strip("'\"")
                if s_val:
                    sources.append(s_val)

git_url = ""
git_ref = "HEAD"
for s_item in sources:
    u = s_item.split("::", 1)[1] if "::" in s_item else s_item
    if u.startswith("git+") or ".git" in u or u.startswith("git://"):
        if u.startswith("git+"):
            u = u[4:]
        if "#" in u:
            u, frag = u.split("#", 1)
            for part in frag.split("&"):
                if part.startswith("branch="):
                    git_ref = f"refs/heads/{part[7:]}"
                elif part.startswith("tag="):
                    git_ref = f"refs/tags/{part[4:]}"
        git_url = u
        break

print(f"GIT_URL={git_url}")
print(f"GIT_REF={git_ref}")
print("DEPS=" + " ".join(dict.fromkeys(deps)))
PYINFO
}

_is_haskell_pkgbuild() {
    local build_dir="$1"
    if [[ -f "$build_dir/Setup.hs" || -f "$build_dir/Setup.lhs" ]]; then
        return 0
    fi
    local info deps dep
    info=$(_extract_pkgbuild_info "$build_dir")
    deps=$(awk -F= '/^DEPS=/{sub(/^DEPS=/, ""); print}' <<< "$info")
    for dep in $deps; do
        if [[ "$dep" =~ ^(ghc|ghc-.*|haskell-.*|cabal-install|stack)$ ]]; then
            return 0
        fi
    done
    return 1
}

# Warn before building a Haskell AUR package if ghc-pkg reports broken registrations.
_preflight_haskell_check() {
    local pkg_name="$1"
    local build_dir="$2"
    command -v ghc-pkg >/dev/null 2>&1 || return 0
    _is_haskell_pkgbuild "$build_dir" || return 0

    local ghc_broken="" ghc_rc=0
    ghc_broken=$(ghc-pkg check --simple-output 2>&1) || ghc_rc=$?
    if [[ $ghc_rc -ne 0 || -n "$ghc_broken" ]]; then
        msg_warn "Haskell preflight ('ghc-pkg check --simple-output') reported broken package(s) before building '$pkg_name': ${ghc_broken:-exit code $ghc_rc}"
        msg_warn "Continuing build; if compilation fails, rebuild broken Haskell packages or let -git fallback run if available."
    fi
    return 0
}

# Run a command with 'yes' piped without tripping set -o pipefail on SIGPIPE.
_run_pipe_yes() {
    local rc=0
    (
        set +o pipefail
        yes | "$@"
        exit "${PIPESTATUS[1]}"
    ) || rc=$?
    return "$rc"
}

# Check whether a package exists in an official/sync repo (excluding custom PARU_WRAPPER_REPO).
_is_official_noncustom_pkg() {
    local pkg="$1"
    local repo_lines
    repo_lines=$(LC_ALL=C pacman -Si "$pkg" 2>/dev/null | awk -F '[ \t]*:[ \t]*' '/^Repository/ { print $2 }' || true)
    [[ -n "$repo_lines" ]] || return 1
    local r
    while IFS= read -r r; do
        [[ -n "$r" && "$r" != "${PARU_WRAPPER_REPO:-}" ]] && return 0
    done <<< "$repo_lines"
    return 1
}

_resolve_git_pkg_commit() {
    local pkg_name="$1"
    local pkg_dir="$2"
    local info git_url git_ref commit=""
    info=$(_extract_pkgbuild_info "$pkg_dir")
    git_url=$(awk -F= '/^GIT_URL=/{sub(/^GIT_URL=/, ""); print}' <<< "$info")
    git_ref=$(awk -F= '/^GIT_REF=/{sub(/^GIT_REF=/, ""); print}' <<< "$info")

    if [[ -n "$git_url" ]]; then
        commit=$(git ls-remote "$git_url" "${git_ref:-HEAD}" 2>/dev/null | awk 'NR==1 {print $1}' || true)
    fi
    if [[ -z "$commit" ]]; then
        local srcdest repo_base cand
        srcdest=$(get_makepkg_srcdest 2>/dev/null || true)
        repo_base="${git_url##*/}"
        repo_base="${repo_base%.git}"
        for cand in "$pkg_dir/src/$repo_base" "${srcdest:+$srcdest/$repo_base}" "$pkg_dir"; do
            if [[ -n "$cand" && -d "$cand" ]] && git -C "$cand" rev-parse -q --verify HEAD >/dev/null 2>&1; then
                commit=$(git -C "$cand" rev-parse HEAD 2>/dev/null || true)
                [[ -n "$commit" ]] && break
            fi
        done
    fi
    if [[ -z "$commit" ]]; then
        commit="${_aur_pkgs_cache["$pkg_name"]:-unknown}"
    fi
    printf '%s\n' "$commit"
}

_record_git_fallback() {
    local git_pkg="$1"
    local release_pkg="$2"
    local failed_commit="$3"
    local ts
    printf -v ts '%(%Y-%m-%dT%H:%M:%SZ)T' -1

    run_as_build_user mkdir -p "$STATE_DIR"
    local tmp_tsv
    tmp_tsv=$(run_as_build_user mktemp "${STATE_DIR}/git-fallbacks.XXXXXX")
    if [[ -f "$GIT_FALLBACKS_FILE" ]]; then
        awk -F '\t' -v target="$git_pkg" '$1 != target && NF >= 3 { print }' "$GIT_FALLBACKS_FILE" > "$tmp_tsv" 2>/dev/null || true
    fi
    printf '%s\t%s\t%s\t%s\n' "$git_pkg" "$release_pkg" "$failed_commit" "$ts" >> "$tmp_tsv"
    run_as_build_user mv -f -T "$tmp_tsv" "$GIT_FALLBACKS_FILE" 2>/dev/null || mv -f -T "$tmp_tsv" "$GIT_FALLBACKS_FILE"
}

_remove_git_fallback() {
    local git_pkg="$1"
    [[ -f "$GIT_FALLBACKS_FILE" ]] || return 0
    grep -q "^${git_pkg}"$'\t' "$GIT_FALLBACKS_FILE" 2>/dev/null || return 0

    local tmp_tsv
    tmp_tsv=$(run_as_build_user mktemp "${STATE_DIR}/git-fallbacks.XXXXXX")
    awk -F '\t' -v target="$git_pkg" '$1 != target && NF >= 3 { print }' "$GIT_FALLBACKS_FILE" > "$tmp_tsv" 2>/dev/null || true
    if [[ -s "$tmp_tsv" ]]; then
        run_as_build_user mv -f -T "$tmp_tsv" "$GIT_FALLBACKS_FILE" 2>/dev/null || mv -f -T "$tmp_tsv" "$GIT_FALLBACKS_FILE"
    else
        rm -f "$tmp_tsv" "$GIT_FALLBACKS_FILE"
    fi
}

_build_and_install_release_aur_pkg() {
    local release_pkg="$1"
    local clone_name="${_aur_pkgbase_cache["$release_pkg"]:-$release_pkg}"
    local rel_dir pkgfiles f sub_pkg target_file=""

    rel_dir=$(run_as_build_user mktemp -d)
    if ! run_as_build_user git clone --depth 1 "https://aur.archlinux.org/${clone_name}.git" "$rel_dir" 2>/dev/null || [[ ! -f "$rel_dir/PKGBUILD" ]]; then
        rm -rf "$rel_dir"
        return 1
    fi
    if ! verify_cloned_aur_dir "$release_pkg" "$rel_dir"; then
        rm -rf "$rel_dir"
        return 1
    fi
    _preflight_haskell_check "$release_pkg" "$rel_dir"

    mapfile -t pkgfiles < <(run_as_build_user env -C "$rel_dir" makepkg --packagelist 2>/dev/null || true)
    if [[ "$clone_name" == "$release_pkg" && ${#pkgfiles[@]} -eq 0 ]]; then
        if run_makepkg_with_recovery "$rel_dir" -Csf --noconfirm; then
            rm -rf "$rel_dir"
            return 0
        fi
        rm -rf "$rel_dir"
        return 1
    fi

    if run_makepkg_with_recovery "$rel_dir" -Csf --noconfirm; then
        mapfile -t pkgfiles < <(run_as_build_user env -C "$rel_dir" makepkg --packagelist 2>/dev/null || true)
        for f in "${pkgfiles[@]}"; do
            [[ -f "$f" ]] || continue
            sub_pkg=$(pacman -Qp "$f" 2>/dev/null | awk '{print $1}' || true)
            if [[ "$sub_pkg" == "$release_pkg" ]]; then
                target_file="$f"
                break
            fi
        done
        if [[ -n "$target_file" && -f "$target_file" ]] && _run_pipe_yes sudo pacman -U --needed -- "$target_file"; then
            rm -rf "$rel_dir"
            return 0
        fi
    fi

    rm -rf "$rel_dir"
    # Fallback to paru if makepkg -s lacked an AUR dependency
    _run_pipe_yes _run_build_cmd "${PARU_BIN:-/usr/bin/paru}" --skipreview -S --needed "$release_pkg"
}

# Fall back to non-git release package when a -git package fails to build in FORCE_REBUILD.
_attempt_git_fallback() {
    local pkg_name="$1"
    local build_dir="$2"
    [[ "$pkg_name" == *-git ]] || return 1

    local release_pkg="${pkg_name%-git}"
    [[ -n "$release_pkg" ]] || return 1

    local failed_commit
    failed_commit=$(_resolve_git_pkg_commit "$pkg_name" "$build_dir")

    if _is_official_noncustom_pkg "$release_pkg"; then
        msg_warn "Fallback: '$pkg_name' failed at commit ${failed_commit}; installing official release package '$release_pkg' instead."
        if _run_pipe_yes sudo pacman -S --needed "$release_pkg"; then
            _record_git_fallback "$pkg_name" "$release_pkg" "$failed_commit"
            dispatch_plugin_hooks package-rebuilt "$pkg_name"
            return 0
        fi
        return 1
    fi

    fetch_aur_metadata_batch "$release_pkg"
    if [[ -n "${_aur_pkgs_cache["$release_pkg"]+x}" ]]; then
        msg_warn "Fallback: '$pkg_name' failed at commit ${failed_commit}; installing AUR release package '$release_pkg' instead."
        if _build_and_install_release_aur_pkg "$release_pkg"; then
            _record_git_fallback "$pkg_name" "$release_pkg" "$failed_commit"
            dispatch_plugin_hooks package-rebuilt "$pkg_name"
            return 0
        fi
    fi
    return 1
}

# Retry recorded -git fallbacks when a newer upstream commit/version is available.
_process_git_fallbacks_retry() {
    [[ -s "${GIT_FALLBACKS_FILE:-}" ]] || return 0

    local -A explicit_set=()
    local t
    for t in "$@"; do
        explicit_set["${t#*/}"]=1
    done

    local -a rows=()
    mapfile -t rows < "$GIT_FALLBACKS_FILE"
    [[ ${#rows[@]} -gt 0 ]] || return 0

    local -a git_pkgs_to_query=()
    local row git_pkg release_pkg failed_commit ts
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r git_pkg release_pkg failed_commit ts <<< "$row"
        [[ -n "$git_pkg" && -n "$release_pkg" ]] || continue
        [[ -n "${explicit_set["$git_pkg"]:-}" ]] && continue
        git_pkgs_to_query+=("$git_pkg")
    done
    [[ ${#git_pkgs_to_query[@]} -gt 0 ]] || return 0

    fetch_aur_metadata_batch "${git_pkgs_to_query[@]}"

    for row in "${rows[@]}"; do
        IFS=$'\t' read -r git_pkg release_pkg failed_commit ts <<< "$row"
        [[ -n "$git_pkg" && -n "$release_pkg" ]] || continue
        [[ -n "${explicit_set["$git_pkg"]:-}" ]] && continue

        local clone_name="${_aur_pkgbase_cache["$git_pkg"]:-$git_pkg}"
        local check_dir latest_commit=""
        check_dir=$(run_as_build_user mktemp -d)
        if ! run_as_build_user git clone --depth 1 "https://aur.archlinux.org/${clone_name}.git" "$check_dir" 2>/dev/null; then
            rm -rf "$check_dir"
            if [[ -d "${PARU_CLONE_DIR:-}/$clone_name" ]]; then
                latest_commit=$(_resolve_git_pkg_commit "$git_pkg" "${PARU_CLONE_DIR}/$clone_name")
            else
                continue
            fi
        else
            latest_commit=$(_resolve_git_pkg_commit "$git_pkg" "$check_dir")
        fi

        if [[ -z "$latest_commit" || "$latest_commit" == "unknown" || "$latest_commit" == "$failed_commit" ]]; then
            msg_info "No new commit yet for fallback '$git_pkg' (still at ${failed_commit}); keeping '$release_pkg'."
            [[ -d "$check_dir" ]] && rm -rf "$check_dir"
            continue
        fi

        msg_info "New commit available for '$git_pkg' (${failed_commit} -> ${latest_commit}). Retrying build..."
        if [[ "${DRY_RUN:-false}" == true ]]; then
            msg_info "DRY RUN: would retry building '$git_pkg' at commit $latest_commit"
            [[ -d "$check_dir" ]] && rm -rf "$check_dir"
            continue
        fi

        if [[ ! -f "$check_dir/PKGBUILD" ]]; then
            rm -rf "$check_dir"
            continue
        fi
        if ! verify_cloned_aur_dir "$git_pkg" "$check_dir"; then
            rm -rf "$check_dir"
            continue
        fi

        _preflight_haskell_check "$git_pkg" "$check_dir"
        local retry_ok=false
        local -a pre_files=() built_files=()
        mapfile -t pre_files < <(run_as_build_user env -C "$check_dir" makepkg --packagelist 2>/dev/null || true)
        if [[ ${#pre_files[@]} -eq 0 ]]; then
            if run_makepkg_with_recovery "$check_dir" -Csf --noconfirm && _run_pipe_yes _run_build_cmd "${PARU_BIN:-/usr/bin/paru}" --skipreview -S --needed "$git_pkg"; then
                retry_ok=true
            fi
        elif run_makepkg_with_recovery "$check_dir" -Csf --noconfirm; then
            mapfile -t built_files < <(run_as_build_user env -C "$check_dir" makepkg --packagelist 2>/dev/null || true)
            local target_file="" f sub_pkg
            for f in "${built_files[@]}"; do
                [[ -f "$f" ]] || continue
                sub_pkg=$(pacman -Qp "$f" 2>/dev/null | awk '{print $1}' || true)
                if [[ "$sub_pkg" == "$git_pkg" ]]; then
                    target_file="$f"
                    break
                fi
            done
            if [[ -n "$target_file" && -f "$target_file" ]] && _run_pipe_yes sudo pacman -U --needed -- "$target_file"; then
                retry_ok=true
            fi
        fi

        rm -rf "$check_dir"
        if [[ "$retry_ok" == true ]]; then
            msg_info "Rebuilt '$git_pkg' successfully at commit ${latest_commit}. Removing fallback entry."
            _remove_git_fallback "$git_pkg"
            dispatch_plugin_hooks package-rebuilt "$git_pkg"
        else
            msg_warn "Retry of '$git_pkg' failed at commit ${latest_commit}; keeping '$release_pkg' and updating fallback state."
            _record_git_fallback "$git_pkg" "$release_pkg" "$latest_commit"
        fi
    done
}

_PARU_WRAPPER_HEAVY_HOOKS=(
    "05-snap-pac-pre.hook"
    "zz-snap-pac-post.hook"
    "zz-snap-pac-postz-grub.hook"
    "paru-completion-update.hook"
    "rebuild-check.hook"
    "list-orphans.hook"
    "fnm-update.hook"
)

_is_pid_alive() {
    local pid="${1:-}"
    [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 0 ]] || return 1
    local stat_line="" stat_tail="" state=""
    if kill -0 "$pid" 2>/dev/null || [[ -d "/proc/$pid" ]]; then
        if read -r stat_line < "/proc/$pid/stat" 2>/dev/null; then
            stat_tail="${stat_line##*)}"
            read -r state _ <<< "$stat_tail" || true
            [[ "$state" == "Z" ]] && return 1
        fi
        return 0
    fi
    return 1
}

_hook_priv_run() {
    local target_dir="${PARU_WRAPPER_HOOKS_DIR:-/etc/pacman.d/hooks}"
    if [[ "$(id -u)" -eq 0 ]] || [[ -d "$target_dir" && -w "$target_dir" ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

_write_hooks_pid_file() {
    local pid_file="${PARU_WRAPPER_HOOKS_PID_FILE:-/run/paru-wrapper-hooks.pid}"
    local pid_dir
    pid_dir=$(dirname "$pid_file")
    if [[ "$(id -u)" -eq 0 ]] || [[ -d "$pid_dir" && -w "$pid_dir" ]]; then
        mkdir -p "$pid_dir" 2>/dev/null || true
        printf '%s\n' "$$" > "$pid_file"
    else
        printf '%s\n' "$$" | sudo tee "$pid_file" >/dev/null
    fi
}

_remove_hooks_pid_file() {
    local pid_file="${PARU_WRAPPER_HOOKS_PID_FILE:-/run/paru-wrapper-hooks.pid}"
    local pid_dir
    pid_dir=$(dirname "$pid_file")
    if [[ "$(id -u)" -eq 0 ]] || [[ -d "$pid_dir" && -w "$pid_dir" ]]; then
        rm -f "$pid_file" 2>/dev/null || true
    else
        sudo rm -f "$pid_file" 2>/dev/null || true
    fi
}

_restore_pacman_hooks() {
    local hooks_dir="${PARU_WRAPPER_HOOKS_DIR:-/etc/pacman.d/hooks}"
    local hook
    for hook in "${_PARU_WRAPPER_HEAVY_HOOKS[@]}"; do
        if [[ -L "$hooks_dir/$hook" && "$(readlink "$hooks_dir/$hook" 2>/dev/null || true)" == "/dev/null" ]]; then
            _hook_priv_run rm -f "$hooks_dir/$hook" 2>/dev/null || true
        fi
        if [[ -f "$hooks_dir/${hook}.paru-wrapper-disabled" ]]; then
            _hook_priv_run mv -f "$hooks_dir/${hook}.paru-wrapper-disabled" "$hooks_dir/$hook" 2>/dev/null || true
        fi
    done
    _remove_hooks_pid_file
}

# Clean up disabled hooks from an interrupted session only when the owner PID is no longer alive.
_cleanup_stale_hooks() {
    local hooks_dir="${PARU_WRAPPER_HOOKS_DIR:-/etc/pacman.d/hooks}"
    local pid_file="${PARU_WRAPPER_HOOKS_PID_FILE:-/run/paru-wrapper-hooks.pid}"
    local any_disabled=false hook
    for hook in "${_PARU_WRAPPER_HEAVY_HOOKS[@]}"; do
        if { [[ -L "$hooks_dir/$hook" ]] && [[ "$(readlink "$hooks_dir/$hook" 2>/dev/null || true)" == "/dev/null" ]]; } || [[ -f "$hooks_dir/${hook}.paru-wrapper-disabled" ]]; then
            any_disabled=true
            break
        fi
    done
    [[ "$any_disabled" == true ]] || return 0

    local owner_pid=""
    if [[ -r "$pid_file" ]]; then
        read -r owner_pid < "$pid_file" 2>/dev/null || true
        owner_pid="${owner_pid//[[:space:]]/}"
    fi
    if [[ -n "$owner_pid" ]] && _is_pid_alive "$owner_pid"; then
        return 0
    fi

    msg_warn "Detected stale disabled hooks from a previous run${owner_pid:+ (PID $owner_pid no longer active)}. Restoring..."
    _restore_pacman_hooks
}

_disable_pacman_hooks() {
    local hooks_dir="${PARU_WRAPPER_HOOKS_DIR:-/etc/pacman.d/hooks}"
    local sys_hooks_dir="${PARU_WRAPPER_SYSTEM_HOOKS_DIR:-/usr/share/libalpm/hooks}"
    local pid_file="${PARU_WRAPPER_HOOKS_PID_FILE:-/run/paru-wrapper-hooks.pid}"

    local owner_pid=""
    if [[ -r "$pid_file" ]]; then
        read -r owner_pid < "$pid_file" 2>/dev/null || true
        owner_pid="${owner_pid//[[:space:]]/}"
    fi
    if [[ -n "$owner_pid" && "$owner_pid" != "$$" ]] && _is_pid_alive "$owner_pid"; then
        msg_info "Hooks already disabled by active paru-wrapper session (PID $owner_pid)."
        return 1
    fi

    _hook_priv_run mkdir -p "$hooks_dir"
    _write_hooks_pid_file
    local hook
    for hook in "${_PARU_WRAPPER_HEAVY_HOOKS[@]}"; do
        if [[ -f "$hooks_dir/$hook" && ! -L "$hooks_dir/$hook" ]]; then
            if [[ ! -f "$hooks_dir/${hook}.paru-wrapper-disabled" ]]; then
                _hook_priv_run mv -f "$hooks_dir/$hook" "$hooks_dir/${hook}.paru-wrapper-disabled"
            fi
            _hook_priv_run ln -sf -T /dev/null "$hooks_dir/$hook"
        elif [[ -e "$sys_hooks_dir/$hook" || -L "$hooks_dir/$hook" ]]; then
            _hook_priv_run ln -sf -T /dev/null "$hooks_dir/$hook"
        fi
    done
    return 0
}

_parse_si_deps() {
    awk '/^(Depends On|Depends|Make Deps|Make Depends|Check Deps)[[:space:]]*:/ { in_depends = 1; sub(/^[^:]*:[[:space:]]*/, ""); print; next } /^[a-zA-Z]/ { in_depends = 0 } in_depends { sub(/^[[:space:]]+/, ""); print }' | tr ' ' '\n' | sed '/^$/d; s/[<>=].*//; /^[Nn]one$/d' | sort -u || true
}

# Purge corrupted paru clone cache directories (missing/broken .git or unreadable objects)
if [ -z "${PARU_CLONE_DIR:-}" ]; then
    if [ "$(id -u)" -eq 0 ] && [ -n "${_PW_INVOKING_HOME:-}" ]; then
        PARU_CLONE_DIR="${_PW_INVOKING_HOME}/.cache/paru/clone"
    else
        PARU_CLONE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/paru/clone"
    fi
fi

is_broken_clone() {
    local d="$1"
    [[ -d "$d" ]] || return 1
    # Check 1: Must be a recognizable git repository
    if ! git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
        return 0
    fi
    # Check 2: If HEAD exists, it must be valid and reset without missing object errors
    if git -C "$d" rev-parse -q --verify HEAD >/dev/null 2>&1; then
        if ! git -C "$d" reset --hard -q HEAD >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

purge_broken_clones() {
    [[ -d "$PARU_CLONE_DIR" ]] || return 0
    local cleaned=0
    for d in "$PARU_CLONE_DIR"/*/; do
        [[ -d "$d" ]] || continue
        if is_broken_clone "$d"; then
            local pkg_name
            pkg_name=$(basename "$d")
            msg_info "Purging corrupted clone cache: $pkg_name (corrupted or missing git objects)"
            rm -rf "${d%/}"
            ((cleaned++)) || true
        fi
    done
    if [[ $cleaned -gt 0 ]]; then
        msg_info "Cleaned $cleaned corrupted clone cache(s)."
    fi
    return 0
}

_CURRENT_ATTEMPT_MARKER=""

# Check whether network connectivity to Arch infrastructure is currently available
is_network_online() {
    if [[ -n "${PARU_WRAPPER_NET_CHECK_CMD:-}" ]]; then
        bash -c "$PARU_WRAPPER_NET_CHECK_CMD" >/dev/null 2>&1
        return $?
    fi

    if command -v ip >/dev/null 2>&1; then
        if [[ -z "$(ip -4 route show default 2>/dev/null)$(ip -6 route show default 2>/dev/null)" ]]; then
            return 1
        fi
    fi

    if command -v curl >/dev/null 2>&1; then
        curl -fsSIL --connect-timeout 3 --max-time 5 "${PARU_WRAPPER_NET_CHECK_URL:-https://archlinux.org}" >/dev/null 2>&1
        return $?
    fi

    if command -v nm-online >/dev/null 2>&1; then
        nm-online -q -t 2 >/dev/null 2>&1
        return $?
    fi

    return 0
}

# Wait with exponential backoff until network connectivity recovers or timeout expires
wait_for_network() {
    local timeout="${1:-${PARU_WRAPPER_NET_WAIT_TIMEOUT:-1800}}"
    if (( timeout <= 0 )); then
        return 1
    fi

    local start_ts now elapsed delay max_delay=30 last_log=0
    delay="${PARU_WRAPPER_NET_POLL_INTERVAL:-2}"
    if (( delay < 1 )); then
        delay=1
    fi
    printf -v start_ts '%(%s)T' -1

    while true; do
        if is_network_online; then
            return 0
        fi

        printf -v now '%(%s)T' -1
        elapsed=$((now - start_ts))
        if (( elapsed >= timeout )); then
            msg_warn "Timed out after ${timeout}s waiting for network connectivity."
            return 1
        fi

        if (( last_log == 0 || now - last_log >= 15 )); then
            msg_info "Waiting for network connectivity to resume (${elapsed}s/${timeout}s)..."
            last_log=$now
        fi

        local remaining=$((timeout - elapsed))
        local sleep_for=$delay
        if (( sleep_for > remaining )); then
            sleep_for=$remaining
        fi
        sleep "$sleep_for"

        delay=$((delay * 2))
        if (( delay > max_delay )); then
            delay=$max_delay
        fi
    done
}

# Read a single variable assignment from ~/.makepkg.conf or /etc/makepkg.conf
read_makepkg_var() {
    local var_name="$1"
    local conf val
    local conf_candidates=("${HOME:-}/.makepkg.conf")
    if [ "$(id -u)" -eq 0 ] && [ -n "${_PW_INVOKING_HOME:-}" ] && [ "$_PW_INVOKING_HOME" != "${HOME:-}" ]; then
        conf_candidates+=("${_PW_INVOKING_HOME}/.makepkg.conf")
    fi
    conf_candidates+=("/etc/makepkg.conf")
    for conf in "${conf_candidates[@]}"; do
        [[ -r "$conf" ]] || continue
        val=$(awk -F '=' -v key="$var_name" '
            $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
                val=$2
                sub(/[[:space:]]*#.*/, "", val)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
                gsub(/^["'\'']|["'\'']$/, "", val)
                print val
            }
        ' "$conf" 2>/dev/null | tail -n 1 || true)
        if [[ -n "$val" ]]; then
            printf '%s\n' "$val"
            return 0
        fi
    done
    return 1
}

# Resolve GPG signing key from env or makepkg.conf
get_makepkg_gpgkey() {
    if [[ -n "${PARU_WRAPPER_GPGKEY:-}" ]]; then
        printf '%s\n' "$PARU_WRAPPER_GPGKEY"
        return 0
    fi
    if [[ -n "${GPGKEY:-}" ]]; then
        printf '%s\n' "$GPGKEY"
        return 0
    fi
    read_makepkg_var "GPGKEY"
}

# Resolve SRCDEST from PARU_WRAPPER_SRCDEST, SRCDEST env, or makepkg.conf
get_makepkg_srcdest() {
    if [[ -n "${PARU_WRAPPER_SRCDEST:-}" ]]; then
        printf '%s\n' "$PARU_WRAPPER_SRCDEST"
        return 0
    fi
    if [[ "${SRCDEST+x}" == "x" ]]; then
        printf '%s\n' "$SRCDEST"
        return 0
    fi
    read_makepkg_var "SRCDEST" || true
}

# Populate target array with repo-add/repo-remove signing flags (-s and optional -k <key>)
get_repo_sign_flags() {
    local -n _out_flags="$1"
    local gpg_key=""
    _out_flags=(-s)
    gpg_key=$(get_makepkg_gpgkey 2>/dev/null || true)
    if [[ -n "$gpg_key" ]]; then
        _out_flags+=(-k "$gpg_key")
    fi
}

# List directories where pacman/makepkg store partial downloads (.part)
collect_part_search_dirs() {
    if [[ -n "${PARU_WRAPPER_PART_SEARCH_DIRS:-}" ]]; then
        local IFS=':'
        local dirs=()
        read -r -a dirs <<< "$PARU_WRAPPER_PART_SEARCH_DIRS"
        printf '%s\n' "${dirs[@]}"
        return 0
    fi

    local pacman_conf="${PARU_WRAPPER_PACMAN_CONF:-/etc/pacman.conf}"
    local found_cache=false
    if [[ -r "$pacman_conf" ]]; then
        local cache_dir
        while IFS= read -r cache_dir; do
            [[ -n "$cache_dir" ]] || continue
            printf '%s\n' "$cache_dir"
            found_cache=true
        done < <(awk -F '=' '/^[[:space:]]*CacheDir[[:space:]]*=/{ gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2 }' "$pacman_conf" 2>/dev/null || true)
    fi
    if [[ "$found_cache" == false ]]; then
        printf '%s\n' "/var/cache/pacman/pkg"
    fi

    printf '%s\n' "/var/lib/pacman/sync"

    local srcdest
    srcdest=$(get_makepkg_srcdest)
    if [[ -n "$srcdest" ]]; then
        printf '%s\n' "$srcdest"
    fi

    if [[ -n "${PARU_CLONE_DIR:-}" ]]; then
        printf '%s\n' "$PARU_CLONE_DIR"
    fi
}

# Return 0 if any .part file (including inside libalpm download-* staging dirs) was touched since marker
has_recent_part_files() {
    local marker="$1"
    [[ -f "$marker" ]] || return 1

    local d match
    while IFS= read -r d; do
        [[ -d "$d" ]] || continue
        match=$(find "$d" -maxdepth 2 -type f -name '*.part' -newer "$marker" -print -quit 2>/dev/null || true)
        if [[ -n "$match" ]]; then
            return 0
        fi
    done < <(collect_part_search_dirs)
    return 1
}

# Run a command with automatic network-drop wait-and-resume (and optional clone repair).
# Pacman (.part in CacheDir) and makepkg (curl -C - .part in SRCDEST) resume natively on re-run.
_run_resumable() {
    local repair_clones="$1"
    shift

    local max_clone_retries="${PARU_WRAPPER_CLONE_REPAIR_MAX:-3}"
    local max_net_retries="${PARU_WRAPPER_NET_RETRY_MAX:-5}"
    local max_part_retries="${PARU_WRAPPER_PART_RETRY_MAX:-2}"
    local retry_delay="${PARU_WRAPPER_RETRY_DELAY:-2}"
    local clone_attempts=0 net_attempts=0 part_attempts=0 exit_code=0

    while true; do
        _CURRENT_ATTEMPT_MARKER=$(mktemp)
        exit_code=0
        "$@" || exit_code=$?

        if [[ $exit_code -eq 0 ]]; then
            rm -f "$_CURRENT_ATTEMPT_MARKER"
            _CURRENT_ATTEMPT_MARKER=""
            return 0
        fi

        # Never retry on signal termination (SIGINT=130, SIGQUIT=131, SIGTERM=143).
        # Exit code 128 is git's fatal error code, not a signal.
        if [[ $exit_code -gt 128 ]]; then
            rm -f "$_CURRENT_ATTEMPT_MARKER"
            _CURRENT_ATTEMPT_MARKER=""
            return "$exit_code"
        fi

        # Scan for broken clone dirs that may have caused a paru failure
        if [[ "$repair_clones" == "1" ]] && ((clone_attempts < max_clone_retries)) && [[ -d "$PARU_CLONE_DIR" ]]; then
            local repaired=false
            for d in "$PARU_CLONE_DIR"/*/; do
                [[ -d "$d" ]] || continue
                if is_broken_clone "$d"; then
                    local pkg_name
                    pkg_name=$(basename "$d")
                    msg_info "Auto-repairing corrupted clone cache: $pkg_name (attempt $((clone_attempts + 1))/$max_clone_retries)"
                    rm -rf "${d%/}"
                    repaired=true
                fi
            done
            if [[ "$repaired" == true ]]; then
                ((++clone_attempts))
                rm -f "$_CURRENT_ATTEMPT_MARKER"
                _CURRENT_ATTEMPT_MARKER=""
                if ! is_network_online; then
                    msg_warn "Network connectivity lost during clone. Waiting for network to recover before retrying..."
                    if ! wait_for_network; then
                        return "$exit_code"
                    fi
                fi
                continue
            fi
        fi

        # Wait for network recovery or resume interrupted .part downloads
        if ((net_attempts < max_net_retries)); then
            if ! is_network_online; then
                rm -f "$_CURRENT_ATTEMPT_MARKER"
                _CURRENT_ATTEMPT_MARKER=""
                msg_warn "Network connectivity lost mid-operation (exit code $exit_code). Waiting for network to recover before resuming..."
                if wait_for_network; then
                    ((++net_attempts))
                    part_attempts=0
                    msg_info "Network connectivity restored. Resuming operation (attempt $net_attempts/$max_net_retries)..."
                    continue
                fi
                return "$exit_code"
            elif has_recent_part_files "$_CURRENT_ATTEMPT_MARKER" && ((part_attempts < max_part_retries)); then
                rm -f "$_CURRENT_ATTEMPT_MARKER"
                _CURRENT_ATTEMPT_MARKER=""
                ((++part_attempts))
                ((++net_attempts))
                msg_info "Detected interrupted partial download (.part). Resuming in ${retry_delay}s (attempt $net_attempts/$max_net_retries)..."
                sleep "$retry_delay"
                continue
            fi
        fi

        rm -f "$_CURRENT_ATTEMPT_MARKER"
        _CURRENT_ATTEMPT_MARKER=""
        return "$exit_code"
    done
}

# Run paru with auto-retry on corrupted clone cache errors and network interruptions
run_paru_with_clone_repair() {
    _run_resumable 1 _run_build_cmd "${PARU_BIN:-/usr/bin/paru}" "$@"
}

# Run a download/build command with automatic network-drop wait-and-resume
run_with_network_resume() {
    _run_resumable 0 "$@"
}

# Extract the conflicting directory from makepkg "<path> is not a clone of <url>" output.
_extract_not_a_clone_path() {
    local log_file="$1"
    [[ -f "$log_file" ]] || return 1
    local line clean_line path
    while IFS= read -r line; do
        clean_line=$(printf '%s' "$line" | sed -E $'s/\x1B(\\[[0-9;?]*[[:alpha:]]|\\([AB012])//g' | tr -d '\r')
        if [[ "$clean_line" =~ ^([[:space:]]*(==>[[:space:]]*)?ERROR:[[:space:]]*)?(.+)[[:space:]]+is\ not\ a\ clone\ of[[:space:]]+([^[:space:]]+)[[:space:]]*$ ]]; then
            path="${BASH_REMATCH[3]}"
            path="${path%"${path##*[![:space:]]}"}"
            if [[ -n "$path" ]]; then
                printf '%s\n' "$path"
                return 0
            fi
        fi
    done < "$log_file"
    return 1
}

# Verify that a reported "not a clone of" path is a git repo dir strictly inside SRCDEST (or build_dir when SRCDEST is unset).
_is_safe_stale_srcdest_clone() {
    local stale_dir="$1"
    local build_dir="${2:-}"
    [[ -n "$stale_dir" && "$stale_dir" == /* && "$stale_dir" != "/" ]] || return 1
    [[ -d "$stale_dir" && ! -L "$stale_dir" ]] || return 1

    local resolved_stale
    resolved_stale=$(readlink -f -- "$stale_dir" 2>/dev/null || true)
    [[ -n "$resolved_stale" && "$resolved_stale" != "/" && -d "$resolved_stale" ]] || return 1

    local srcdest resolved_srcdest="" resolved_build_dir=""
    srcdest=$(get_makepkg_srcdest)
    if [[ -n "$srcdest" ]]; then
        resolved_srcdest=$(readlink -f -- "$srcdest" 2>/dev/null || true)
        [[ -n "$resolved_srcdest" && "$resolved_stale" == "$resolved_srcdest/"* && "$resolved_stale" != "$resolved_srcdest" ]] || return 1
    elif [[ -n "$build_dir" ]]; then
        resolved_build_dir=$(readlink -f -- "$build_dir" 2>/dev/null || true)
        [[ -n "$resolved_build_dir" && "$resolved_stale" == "$resolved_build_dir/"* && "$resolved_stale" != "$resolved_build_dir" ]] || return 1
    else
        return 1
    fi

    # Match git working repos, bare mirrors, and incomplete/broken bare clones missing config/HEAD
    [[ -d "$resolved_stale/objects" || -f "$resolved_stale/HEAD" || -d "$resolved_stale/.git" ]] || return 1
    return 0
}

_has_cleanbuild_flag() {
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--cleanbuild" ]] || [[ "$arg" =~ ^-[a-zA-Z]*C[a-zA-Z]*$ ]]; then
            return 0
        fi
    done
    return 1
}

# Execute makepkg as the build user while streaming stdout/stderr live and capturing combined output.
_run_makepkg_with_tee() {
    local log_file="$1"
    local build_dir="$2"
    shift 2

    : > "$log_file"
    local fifo_dir out_fifo err_fifo pid_out pid_err rc=0
    fifo_dir=$(mktemp -d)
    out_fifo="$fifo_dir/out.fifo"
    err_fifo="$fifo_dir/err.fifo"
    mkfifo "$out_fifo" "$err_fifo"

    tee -a "$log_file" < "$out_fifo" &
    pid_out=$!
    tee -a "$log_file" < "$err_fifo" >&2 &
    pid_err=$!

    _run_build_cmd env -C "$build_dir" makepkg "$@" > "$out_fifo" 2> "$err_fifo" || rc=$?

    wait "$pid_out" "$pid_err" 2>/dev/null || true
    rm -rf "$fifo_dir"
    return "$rc"
}

# Run makepkg with live output, stale SRCDEST git clone auto-recovery, and cleanbuild (-C) retry.
run_makepkg_with_recovery() {
    local build_dir="$1"
    shift
    local makepkg_args=("$@")

    local makepkg_log
    makepkg_log=$(mktemp)

    local srcdest_retried=0 cleanbuild_retried=0 rc=0
    while true; do
        rc=0
        run_with_network_resume _run_makepkg_with_tee "$makepkg_log" "$build_dir" "${makepkg_args[@]}" || rc=$?

        if [[ $rc -eq 0 || $rc -gt 128 ]]; then
            rm -f "$makepkg_log"
            return "$rc"
        fi

        local stale_dir=""
        if (( srcdest_retried == 0 )) && stale_dir=$(_extract_not_a_clone_path "$makepkg_log"); then
            if _is_safe_stale_srcdest_clone "$stale_dir" "$build_dir"; then
                msg_warn "Detected stale/mismatched SRCDEST git clone '$stale_dir'. Removing and retrying makepkg..."
                run_as_build_user rm -rf -- "$stale_dir" 2>/dev/null || rm -rf -- "$stale_dir"
                if [[ ! -e "$stale_dir" ]]; then
                    srcdest_retried=1
                    continue
                fi
                msg_warn "Failed to remove stale SRCDEST clone '$stale_dir'; aborting retry."
            else
                msg_warn "Refusing to auto-remove '$stale_dir' reported by makepkg (not a verified git clone inside SRCDEST)."
            fi
        fi

        if (( cleanbuild_retried == 0 )) && ! _has_cleanbuild_flag "${makepkg_args[@]}"; then
            local clean_log
            clean_log=$(sed -E $'s/\x1B(\\[[0-9;?]*[[:alpha:]]|\\([AB012])//g' "$makepkg_log" 2>/dev/null || true)
            if grep -qE 'A failure occurred in (prepare|build)\(\)|locally modified|Reversed \(or previously applied\) patch' <<< "$clean_log"; then
                msg_warn "makepkg failed in prepare()/build() without cleanbuild. Retrying with -C (--cleanbuild)..."
                makepkg_args=(-C "${makepkg_args[@]}")
                cleanbuild_retried=1
                continue
            fi
        fi

        rm -f "$makepkg_log"
        return "$rc"
    done
}

# Check whether a PID belongs to an active repo-add/repo-remove process
is_live_repo_tool_pid() {
    local pid="$1"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [[ "$pid" -gt 0 ]] || return 1
    [[ -d "/proc/$pid" ]] || return 1

    local stat_line stat_tail state
    if read -r stat_line < "/proc/$pid/stat" 2>/dev/null; then
        stat_tail="${stat_line##*)}"
        if read -r state _ <<< "$stat_tail" && [[ "$state" == "Z" ]]; then
            return 1
        fi
    fi

    if [[ -r "/proc/$pid/cmdline" ]]; then
        local cmd_args=() arg
        mapfile -d '' -t cmd_args < "/proc/$pid/cmdline" 2>/dev/null || true
        [[ ${#cmd_args[@]} -gt 0 ]] || return 1
        for arg in "${cmd_args[@]}"; do
            if [[ "${arg##*/}" =~ ^repo-(add|remove|elephant)$ ]]; then
                return 0
            fi
        done
        return 1
    fi

    return 0
}

# Remove stale repo DB lockfiles left behind by dead/crashed repo-add/repo-remove
# processes and wait boundedly if an active process holds the lock.
ensure_repo_lock_clear() {
    local db_path="${1:-}"
    local timeout="${2:-120}"
    [[ -n "$db_path" ]] || return 0

    local lockfile="${db_path}.lck"
    if [[ ! -e "$lockfile" && ! -L "$lockfile" ]]; then
        return 0
    fi

    local now deadline elapsed last_log=0
    printf -v now '%(%s)T' -1
    deadline=$((now + timeout))

    while true; do
        if [[ ! -e "$lockfile" && ! -L "$lockfile" ]]; then
            return 0
        fi

        local raw_pid="" current_pid=""
        raw_pid=$(cat "$lockfile" 2>/dev/null || true)
        raw_pid="${raw_pid//[[:space:]]/}"

        if [[ -z "$raw_pid" ]]; then
            local mtime=0 age=5
            printf -v now '%(%s)T' -1
            mtime=$(stat -c %Y "$lockfile" 2>/dev/null || echo 0)
            age=$((now - mtime))
            if (( age < 5 && now < deadline )); then
                sleep 1
                continue
            fi
            current_pid=$(cat "$lockfile" 2>/dev/null || true)
            current_pid="${current_pid//[[:space:]]/}"
            if [[ -z "$current_pid" ]]; then
                rm -f "$lockfile" 2>/dev/null || true
                if [[ ! -e "$lockfile" && ! -L "$lockfile" ]]; then
                    msg_warn "Removed stale empty repository lockfile: $lockfile"
                    return 0
                fi
                msg_warn "Failed to remove stale repository lockfile: $lockfile"
                return 1
            fi
            continue
        fi

        if ! is_live_repo_tool_pid "$raw_pid"; then
            current_pid=$(cat "$lockfile" 2>/dev/null || true)
            current_pid="${current_pid//[[:space:]]/}"
            if [[ "$current_pid" == "$raw_pid" ]]; then
                rm -f "$lockfile" 2>/dev/null || true
                if [[ ! -e "$lockfile" && ! -L "$lockfile" ]]; then
                    msg_warn "Removed stale repository lockfile '$lockfile' (PID $raw_pid is no longer active)."
                    return 0
                fi
                msg_warn "Failed to remove stale repository lockfile: $lockfile"
                return 1
            fi
            continue
        fi

        printf -v now '%(%s)T' -1
        if (( now >= deadline )); then
            msg_warn "Timed out waiting for repository lockfile '$lockfile' held by active PID $raw_pid."
            return 1
        fi

        if (( last_log == 0 || now - last_log >= 15 )); then
            msg_info "Waiting for active repository lockfile '$lockfile' (PID $raw_pid)..."
            last_log=$now
        fi

        sleep 1
    done
}

