# Safely clean up any stale disabled hooks from a dead previous transaction
_cleanup_stale_hooks

_PARU_VALUE_FLAGS='--aururl|--aurrpcurl|--editor|--makepkg|--pacman|--pacman-conf|--git|--gpg|--sudo|--pkgctl|--fm|--bat|--makepkgconf|--editorflags|--mflags|--gitflags|--gpgflags|--sudoflags|--batflags|--fmflags|--chrootflags|--chrootpkgs|--rootchrootpkgs|--completioninterval|--minimumreleaseage|--minimumreleaseageexclude|--sortby|--searchby|--limit|--develsuffixes|--builddir|--clonedir|--develfile|--dbpath|--root|--ask|--cachedir|--arch|--color|--config|--gpgdir|--hookdir|--logfile|--sysroot|--ignore|--ignoregroup|--ignoredevel|--assume-installed|--print-format|--overwrite|--mode'

# Split CLI arguments into flag args (preserving attached values) and positional targets
split_paru_args() {
    local -n _out_flags="$1"
    local -n _out_targets="$2"
    shift 2
    _out_flags=()
    _out_targets=()
    local expect_val=false end_of_ops=false arg
    for arg in "$@"; do
        if [ "$end_of_ops" = true ]; then
            _out_targets+=("$arg")
        elif [ "$expect_val" = true ]; then
            _out_flags+=("$arg")
            expect_val=false
        elif [[ "$arg" == "--" ]]; then
            end_of_ops=true
        elif [[ "$arg" == --*=* ]]; then
            _out_flags+=("$arg")
        elif [[ "$arg" =~ ^($_PARU_VALUE_FLAGS)$ ]] || [[ "$arg" =~ ^-[a-zA-Z]*[br]$ ]]; then
            _out_flags+=("$arg")
            expect_val=true
        elif [[ "$arg" == -* && "$arg" != "-" ]]; then
            _out_flags+=("$arg")
        else
            _out_targets+=("$arg")
        fi
    done
}

# Only run orphan cleaning if we are doing a system upgrade or installing/upgrading packages.
is_transaction=false
if [ $# -eq 0 ]; then
    is_transaction=true
    set -- "-Syu"
fi

for arg in "$@"; do
    if [[ "$arg" =~ ^-S[a-zA-Z]*$ ]]; then
        if [[ ! "$arg" =~ [silgpq] ]]; then
            is_transaction=true
            break
        fi
    elif [[ "$arg" =~ ^-U[a-zA-Z]*$ ]]; then
        is_transaction=true
        break
    fi
done

is_search_install=false
if [ "$is_transaction" = false ] && [ $# -gt 0 ]; then
    has_op_flag=false
    for arg in "$@"; do
        if [[ "$arg" =~ ^-[SQRDFFTUGPBCVh] ]] || \
           [[ "$arg" =~ ^-[a-zA-Z]*[SQRDFFTUGPBCVh] ]] || \
           [[ "$arg" =~ ^-(c|h|V)$ ]] || \
           [[ "$arg" =~ ^--(sync|query|remove|database|files|deptest|upgrade|getpkgbuild|show|build|clean|help|version)$ ]]; then
            has_op_flag=true
            break
        fi
    done
    if [ "$has_op_flag" = false ]; then
        is_search_install=true
    fi
fi

if [ "$is_search_install" = true ]; then
    if [ "$DRY_RUN" = true ]; then
        msg_info "DRY RUN: would run interactive search selection and, if packages are selected, pre-transaction hooks and /usr/bin/paru --pacman /usr/bin/pacman-wrapper $*"
        exit 0
    fi

    select_file=$(mktemp)
    trap 'rm -f "${select_file:-}"' EXIT INT TERM
    purge_broken_clones
    exit_code=0
    PARU_SEARCH_SELECT_FILE="$select_file" run_paru_with_clone_repair "$@" || exit_code=$?

    if [ "$exit_code" -ne 0 ] || [ ! -s "$select_file" ]; then
        rm -f "$select_file"
        trap - EXIT INT TERM
        exit "$exit_code"
    fi

    selected_targets=()
    while IFS= read -r _sel_line; do
        [[ -n "$_sel_line" ]] && selected_targets+=("$_sel_line")
    done < "$select_file"
    rm -f "$select_file"
    trap - EXIT INT TERM

    if [ ${#selected_targets[@]} -eq 0 ]; then
        exit 1
    fi

    # Preserve search flags and their values while replacing query terms with selected packages
    search_flags=()
    _discard_queries=()
    split_paru_args search_flags _discard_queries "$@"

    set -- "-S" "${search_flags[@]}" "${selected_targets[@]}"
    is_transaction=true
    is_search_install=false
fi

force_rebuild_failures=()
if [ "$is_transaction" = true ]; then
    # Detect if we are running in an anneal rebuild session
    is_anneal=false
    curr_pid=$$
    # Performance Optimization: Traverse process tree using native bash reads from /proc
    # instead of spawning `ps` and `tr` in a loop. Eliminates O(N) process forks and
    # speeds up is_anneal detection from ~50ms per iteration to <1ms.
    while [ -n "$curr_pid" ] && [ "$curr_pid" -ne 1 ]; do
        read -r proc_name < "/proc/$curr_pid/comm" 2>/dev/null || break
        if [ "$proc_name" = "anneal" ]; then
            is_anneal=true
            break
        fi
        read -r stat_line < "/proc/$curr_pid/stat" 2>/dev/null || break
        # Extract everything after the last parenthesis to safely skip process names with spaces/parens
        stat_tail="${stat_line##*)}"
        if read -r _ ppid _ <<< "$stat_tail"; then
            curr_pid="$ppid"
        else
            break
        fi
    done

    hooks_disabled=false
    if [ "$(id -u)" -eq 0 ] && [ -n "${_PW_INVOKING_HOME:-}" ]; then
        CACHE_DIR="${_PW_INVOKING_HOME}/.cache/paru-wrapper"
        run_as_build_user mkdir -p "$CACHE_DIR"
    else
        CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/paru-wrapper"
        mkdir -p "$CACHE_DIR"
    fi

    declare -a _batch_cleanup_dirs=()
    if [ "$is_anneal" = true ] || [ "${FORCE_REBUILD:-0}" = "1" ]; then
        if [ "$DRY_RUN" = true ]; then
            msg_info "DRY RUN: would temporarily disable redundant pacman hooks"
            hooks_disabled=true
        elif _disable_pacman_hooks; then
            msg_info "Temporarily disabling redundant hooks..."
            hooks_disabled=true
        fi
    fi

    start_marker=$(mktemp)

    cleanup_hooks() {
        # Restore pacman hooks
        if [ "$hooks_disabled" = true ] && [ "$DRY_RUN" != true ]; then
            _restore_pacman_hooks
        fi
        if [ ${#_batch_cleanup_dirs[@]} -gt 0 ]; then
            rm -rf "${_batch_cleanup_dirs[@]}" 2>/dev/null || true
            _batch_cleanup_dirs=()
        fi
        rm -f "$CACHE_DIR/paru_total_packages" "$CACHE_DIR/paru_completed_packages" "${_CURRENT_ATTEMPT_MARKER:-}" 2>/dev/null || true

        # Automatically update custom repository database with any packages built during the wrapper run
        if [ -n "$PARU_WRAPPER_REPO" ] && [ -f "$start_marker" ]; then
            REPO_DIR=$(dirname "$PARU_WRAPPER_REPO_DB")
            mapfile -t new_pkgs < <(find "$REPO_DIR" -name "*.pkg.tar.zst" -newer "$start_marker" 2>/dev/null || true)
            if [ ${#new_pkgs[@]} -gt 0 ]; then
                filtered_new_pkgs=()
                for pkg_file in "${new_pkgs[@]}"; do
                    pkg_base=$(basename "$pkg_file")
                    pkg_name=$(echo "$pkg_base" | sed -E 's/-[0-9].*//')
                    if [[ ! "$pkg_name" =~ -git$ ]] && pacman -Qq "${pkg_name}-git" >/dev/null 2>&1; then
                        msg_info "Skipping auto-indexing of '$pkg_base' because installed '${pkg_name}-git' takes priority."
                        rm -f "$pkg_file" "${pkg_file}.sig" 2>/dev/null || true
                    else
                        filtered_new_pkgs+=("$pkg_file")
                    fi
                done
                new_pkgs=("${filtered_new_pkgs[@]}")
            fi
            if [ ${#new_pkgs[@]} -gt 0 ]; then
                echo "" >&2
                msg_info "Detected ${#new_pkgs[@]} newly built package(s):"
                for pkg in "${new_pkgs[@]}"; do
                    echo "  -> $(basename "$pkg")" >&2
                done
                msg_info "Automatically updating $PARU_WRAPPER_REPO repository database at ${PARU_WRAPPER_REPO_DB}..."
                local repo_sign_flags=()
                get_repo_sign_flags repo_sign_flags
                if [ "$DRY_RUN" = true ]; then
                    msg_info "DRY RUN: would run: repo-add ${repo_sign_flags[*]} -R -w \"${PARU_WRAPPER_REPO_DB}\" \"${new_pkgs[*]}\""
                else
                    if ensure_repo_lock_clear "$PARU_WRAPPER_REPO_DB"; then
                        run_as_repo_owner repo-add "${repo_sign_flags[@]}" -R -w "$PARU_WRAPPER_REPO_DB" "${new_pkgs[@]}" || msg_warn "Failed to update repository database"
                        msg_info "$PARU_WRAPPER_REPO repository database updated successfully."
                    else
                        msg_warn "Skipping repository database update because lockfile could not be acquired."
                    fi
                fi
            fi
            rm -f "$start_marker"
        fi
    }
    trap cleanup_hooks EXIT INT TERM

    # Dispatch pre-transaction plugin hooks (e.g. filesystem snapshotting)
    dispatch_plugin_hooks pre-transaction

    # Prune outdated unmodified packages from custom repo using helper script to trigger upgrades from AUR
    if [ -n "$PARU_WRAPPER_REPO" ]; then
        export PARU_WRAPPER_REPO PARU_WRAPPER_REPO_DB PARU_WRAPPER_PROJECTS_DIR PARU_WRAPPER_AUTO_UPDATE_INSTALLED
        aur_updater=()
        if [ -x "/usr/bin/update_mkvpkg_aur.py" ]; then
            aur_updater=("/usr/bin/update_mkvpkg_aur.py")
        elif [ -f "$(dirname "$0")/update_mkvpkg_aur.py" ]; then
            aur_updater=(python3 "$(dirname "$0")/update_mkvpkg_aur.py")
        fi

        if [ ${#aur_updater[@]} -gt 0 ]; then
            if [ "$DRY_RUN" = true ]; then
                msg_info "DRY RUN: would run ${aur_updater[*]}"
            else
                "${aur_updater[@]}" || msg_warn "update_mkvpkg_aur.py failed"
            fi
        fi
    fi

    # Extract target packages and other arguments
    targets=()
    other_args=()
    split_paru_args other_args targets "$@"
    is_rebuild_cmd=false
    is_system_upgrade=false
    for arg in "${other_args[@]}"; do
        if [[ "$arg" == "--rebuild" || "$arg" == "--redownload" ]]; then
            is_rebuild_cmd=true
        fi
        if [[ "$arg" =~ ^-S[a-zA-Z]*u[a-zA-Z]*$ || "$arg" == "--sysupgrade" ]]; then
            is_system_upgrade=true
        fi
    done

    # If --rebuild or --redownload is requested, purge stale prebuilt binaries from local repo
    if [ "$is_rebuild_cmd" = true ] && [ ${#targets[@]} -gt 0 ]; then
        export FORCE_REBUILD=1
        if [ -n "${PARU_WRAPPER_REPO_DB:-}" ]; then
            REPO_DIR=$(dirname "$PARU_WRAPPER_REPO_DB")
            for pkg in "${targets[@]}"; do
                pkg_name="${pkg#*/}"
                echo "[paru-wrapper] Rebuild requested for '$pkg'. Purging stale binaries from $PARU_WRAPPER_REPO..." >&2
                rm -f "$REPO_DIR/$pkg_name-"*.pkg.tar.zst "$REPO_DIR/$pkg_name-"*.pkg.tar.zst.sig 2>/dev/null || true
                if ensure_repo_lock_clear "$PARU_WRAPPER_REPO_DB"; then
                    repo_sign_flags=()
                    get_repo_sign_flags repo_sign_flags
                    run_as_repo_owner repo-remove "${repo_sign_flags[@]}" -w "$PARU_WRAPPER_REPO_DB" "$pkg_name" >/dev/null 2>&1 || true
                fi
            done
            sudo pacman -Sy >/dev/null 2>&1 || true
        fi
    fi

    # Pre-cache official status for all target packages using a single pacman invocation
    # Performance Optimization: Offload filtering to awk and populate cache via eval
    # to eliminate slow O(N) bash while-read loop overhead.
    declare -A _official_pkgs_cache=()
    if [ ${#targets[@]} -gt 0 ]; then
        eval "$(LC_ALL=C pacman -Si "${targets[@]}" 2>/dev/null | awk -F '[ \t]*:[ \t]*' -v repo="$PARU_WRAPPER_REPO" '
            /^Repository/ { r=$2 }
            /^Name/ {
                if (r != "" && r != repo) {
                    printf "_official_pkgs_cache[\"%s\"]=1\n", $2
                    printf "_official_pkgs_cache[\"%s/%s\"]=1\n", r, $2
                }
            }
        ')"
    fi

    # Helper to check if package is in official repos
    is_official_pkg() {
        local pkg="$1"
        if [[ "$pkg" == aur/* ]]; then
            return 1
        fi
        if [[ "${_official_pkgs_cache["$pkg"]:-}" == 1 ]]; then
            return 0
        fi
        return 1
    }

    # Pre-fetch AUR metadata in batches (strip any repo/ prefix for AUR RPC lookup)
    unofficial_targets=()
    for pkg in "${targets[@]}"; do
        if ! is_official_pkg "$pkg"; then
            unofficial_targets+=("${pkg#*/}")
        fi
    done
    if [[ ${#unofficial_targets[@]} -gt 0 ]]; then
        fetch_aur_metadata_batch "${unofficial_targets[@]}"
    fi

    # Filter targets and rebuild local packages
    filtered_targets=()
    force_rebuild_failures=()
    _pending_batch_pkgs=()
    _pending_batch_files=()
    declare -A _seen_batch_pkgs=()
    declare -A _batch_pkg_build_dirs=()
    declare -a _target_extra_deps=()
    _DEFER_BATCH_INSTALL=0
    if _is_batch_install_enabled; then
        _DEFER_BATCH_INSTALL=1
    fi

    for pkg in "${targets[@]}"; do
        if is_official_pkg "$pkg"; then
            filtered_targets+=("$pkg")
        else
            pkg_name="${pkg#*/}"
            # If MKVPKG/<pkg> was pruned by update_mkvpkg_aur.py, unqualify it so AUR install succeeds
            if [[ -n "$PARU_WRAPPER_REPO" && "$pkg" == "$PARU_WRAPPER_REPO/"* ]] && ! pacman -Si "$pkg" >/dev/null 2>&1; then
                pkg="$pkg_name"
            fi

            if [[ -n "${_aur_pkgs_cache["$pkg_name"]+x}" ]]; then
                in_aur=1
            else
                in_aur=0
            fi
            if [[ "$pkg" == */* && "$pkg" != "$PARU_WRAPPER_REPO/"* && "$pkg" != aur/* ]]; then
                # Explicit custom PKGBUILD/non-ALPM repo target (not MKVPKG or aur)
                filtered_targets+=("$pkg")
            elif [ "$in_aur" -eq 0 ] && [[ "${_aur_rpc_failed_pkgs["$pkg_name"]:-0}" -eq 1 ]] && [ ! -f "${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}/PKGBUILD" ]; then
                # AUR RPC lookup failed (DNS/network error): never misclassify as "not in the AUR"
                msg_warn "AUR RPC lookup failed for '$pkg'; avoiding false 'not in AUR' classification and passing through to paru."
                filtered_targets+=("$pkg")
            elif [ "$in_aur" -eq 0 ]; then
                # Local package not in AUR: rebuild from PROJECTS_DIR if available
                if [ -d "${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}" ] && [ -f "${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}/PKGBUILD" ]; then
                    local_makepkg_flags="-sfi"
                    if [ "${FORCE_REBUILD:-0}" = "1" ]; then
                        local_makepkg_flags="-Csfi"
                    fi
                    local_info=$(_extract_pkgbuild_info "${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}")
                    local_deps=$(awk -F= '/^DEPS=/{sub(/^DEPS=/, ""); print}' <<< "$local_info")
                    [[ -n "$local_deps" ]] && _target_extra_deps+=($local_deps)
                    msg_info "Rebuilding local package '$pkg_name' from source in ${PARU_WRAPPER_PROJECTS_DIR}..."
                    if [ "$DRY_RUN" = true ]; then
                        msg_info "DRY RUN: would run: (cd \"${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}\" && makepkg ${local_makepkg_flags} --noconfirm)"
                    else
                        _preflight_haskell_check "$pkg_name" "${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}"
                        if run_makepkg_with_recovery "${PARU_WRAPPER_PROJECTS_DIR}/${pkg_name}" "$local_makepkg_flags" --noconfirm; then
                            dispatch_plugin_hooks package-rebuilt "$pkg_name"
                        else
                            msg_warn "Failed to rebuild local package '$pkg_name' from ${PARU_WRAPPER_PROJECTS_DIR}."
                            force_rebuild_failures+=("$pkg_name")
                        fi
                    fi
                elif [[ "$pkg" == aur/* ]]; then
                    filtered_targets+=("$pkg")
                else
                    msg_warn "Package '$pkg' is not in the AUR and no source found in ${PARU_WRAPPER_PROJECTS_DIR}. Skipping."
                fi
            elif [ "${FORCE_REBUILD:-0}" = "1" ]; then
                # Force rebuild standard AUR package from source to link against new libraries
                clone_name="${_aur_pkgbase_cache["$pkg_name"]:-$pkg_name}"
                msg_info "FORCE_REBUILD active. Rebuilding AUR package '$pkg_name' (base: '$clone_name') from source..."
                if [ "$DRY_RUN" = true ]; then
                    msg_info "DRY RUN: would clone '$clone_name' and rebuild '$pkg_name' from AUR."
                else
                    if [[ -n "${_blocked_pkgbases["$clone_name"]:-}" ]]; then
                        msg_warn "Skipping '$pkg_name' because pkgbase '$clone_name' failed security verification."
                        force_rebuild_failures+=("$pkg_name")
                        continue
                    fi
                    if [[ -n "${_built_split_files["$pkg_name"]:-}" && -f "${_built_split_files["$pkg_name"]}" ]]; then
                        if [[ "$_DEFER_BATCH_INSTALL" == "1" ]]; then
                            if [[ -z "${_seen_batch_pkgs["$pkg_name"]:-}" ]]; then
                                _seen_batch_pkgs["$pkg_name"]=1
                                _pending_batch_pkgs+=("$pkg_name")
                                _pending_batch_files+=("${_built_split_files["$pkg_name"]}")
                            fi
                        else
                            msg_info "Installing already-built split subpackage '$pkg_name' from '$clone_name'..."
                            if sudo pacman -U --noconfirm -- "${_built_split_files["$pkg_name"]}"; then
                                [[ "$pkg_name" == *-git ]] && _remove_git_fallback "$pkg_name"
                                dispatch_plugin_hooks package-rebuilt "$pkg_name"
                            else
                                msg_warn "Failed to install split subpackage '$pkg_name'."
                                force_rebuild_failures+=("$pkg_name")
                            fi
                        fi
                        continue
                    fi
                    build_dir=$(run_as_build_user mktemp -d)
                    if run_as_build_user git clone --depth 1 "https://aur.archlinux.org/$clone_name.git" "$build_dir" 2>/dev/null; then
                        if [[ ! -f "$build_dir/PKGBUILD" ]]; then
                            msg_warn "Cloned AUR repository for '$pkg_name' (base: '$clone_name') has no PKGBUILD. Passing to paru."
                            rm -rf "$build_dir"
                            filtered_targets+=("$pkg")
                            continue
                        fi
                        cloned_info=$(_extract_pkgbuild_info "$build_dir")
                        cloned_deps=$(awk -F= '/^DEPS=/{sub(/^DEPS=/, ""); print}' <<< "$cloned_info")
                        [[ -n "$cloned_deps" ]] && _target_extra_deps+=($cloned_deps)
                        if ! verify_cloned_aur_dir "$pkg_name" "$build_dir"; then
                            msg_warn "Skipping '$pkg_name' due to failed security verification."
                            _blocked_pkgbases["$clone_name"]=1
                            rm -rf "$build_dir"
                            force_rebuild_failures+=("$pkg_name")
                            continue
                        fi
                        if rebuild_cloned_aur_package "$pkg_name" "$clone_name" "$build_dir" "${targets[@]}"; then
                            if [[ "$_DEFER_BATCH_INSTALL" == "1" && -n "${_LAST_BUILT_PKG_FILE:-}" ]]; then
                                if [[ -z "${_seen_batch_pkgs["$pkg_name"]:-}" ]]; then
                                    _seen_batch_pkgs["$pkg_name"]=1
                                    _pending_batch_pkgs+=("$pkg_name")
                                    _pending_batch_files+=("$_LAST_BUILT_PKG_FILE")
                                    _batch_pkg_build_dirs["$pkg_name"]="$build_dir"
                                fi
                                _batch_cleanup_dirs+=("$build_dir")
                            else
                                [[ "$pkg_name" == *-git ]] && _remove_git_fallback "$pkg_name"
                                dispatch_plugin_hooks package-rebuilt "$pkg_name"
                                rm -rf "$build_dir"
                            fi
                        else
                            if [[ "$pkg_name" == *-git ]] && _attempt_git_fallback "$pkg_name" "$build_dir"; then
                                :
                            else
                                msg_warn "Failed to rebuild AUR package '$pkg_name'."
                                force_rebuild_failures+=("$pkg_name")
                            fi
                            rm -rf "$build_dir"
                        fi
                    else
                        msg_warn "Failed to clone '$clone_name' from AUR for '$pkg_name'. Passing to paru."
                        rm -rf "$build_dir"
                        filtered_targets+=("$pkg")
                    fi
                fi
            else
                # Not a local modified package, must be standard AUR package
                filtered_targets+=("$pkg")
            fi
        fi
    done

    # Install all batched FORCE_REBUILD packages in one pacman -U transaction
    if [ ${#_pending_batch_files[@]} -gt 0 ]; then
        msg_info "Installing ${#_pending_batch_files[@]} rebuilt package(s) in a single batched transaction..."
        if sudo pacman -U --noconfirm -- "${_pending_batch_files[@]}"; then
            for _bp in "${_pending_batch_pkgs[@]}"; do
                [[ "$_bp" == *-git ]] && _remove_git_fallback "$_bp"
                dispatch_plugin_hooks package-rebuilt "$_bp"
            done
        else
            msg_warn "Batched pacman -U failed; falling back to per-package installation..."
            for _bidx in "${!_pending_batch_files[@]}"; do
                _bf="${_pending_batch_files[$_bidx]}"
                _bp="${_pending_batch_pkgs[$_bidx]}"
                if sudo pacman -U --noconfirm -- "$_bf"; then
                    [[ "$_bp" == *-git ]] && _remove_git_fallback "$_bp"
                    dispatch_plugin_hooks package-rebuilt "$_bp"
                elif [[ "$_bp" == *-git && -n "${_batch_pkg_build_dirs["$_bp"]:-}" ]] && _attempt_git_fallback "$_bp" "${_batch_pkg_build_dirs["$_bp"]}"; then
                    :
                else
                    msg_warn "Failed to install rebuilt package '$_bp'."
                    force_rebuild_failures+=("$_bp")
                fi
            done
        fi
        if [ ${#_batch_cleanup_dirs[@]} -gt 0 ]; then
            rm -rf "${_batch_cleanup_dirs[@]}" 2>/dev/null || true
            _batch_cleanup_dirs=()
        fi
    fi

    # Check recorded -git fallbacks for newer upstream commits on update or rebuild runs
    if [ "$is_system_upgrade" = true ] || [ "${FORCE_REBUILD:-0}" = "1" ]; then
        _process_git_fallbacks_retry "${targets[@]}"
    fi

    # Update command-line arguments to exclude filtered-out local packages
    set -- "${other_args[@]}" "${filtered_targets[@]}"

    if [ ${#targets[@]} -gt 0 ] && [ ${#filtered_targets[@]} -eq 0 ]; then
        if [ ${#force_rebuild_failures[@]} -gt 0 ]; then
            msg_warn "Rebuild completed with failures for: ${force_rebuild_failures[*]}"
            exit 1
        fi
        msg_info "All requested targets rebuilt locally. Skipping paru execution."
        exit 0
    fi

    # 1. Get the list of packages to be upgraded
    upgrades=$("${PARU_BIN:-/usr/bin/paru}" -Quq 2>/dev/null || true)

    # Write total packages to paru_total_packages for progress counter
    if [[ -n "$upgrades" ]]; then
        total_pkgs=$(echo "$upgrades" | grep -v "^$" | grep -c "")
        tmp_total=$(mktemp "$CACHE_DIR/paru_total_packages.XXXXXX" 2>/dev/null || true)
        if [ -n "$tmp_total" ]; then
            echo "$total_pkgs" > "$tmp_total"
            mv -f -T "$tmp_total" "$CACHE_DIR/paru_total_packages"
        fi
        tmp_comp=$(mktemp "$CACHE_DIR/paru_completed_packages.XXXXXX" 2>/dev/null || true)
        if [ -n "$tmp_comp" ]; then
            echo "0" > "$tmp_comp"
            mv -f -T "$tmp_comp" "$CACHE_DIR/paru_completed_packages"
        fi
    else
        rm -f "$CACHE_DIR/paru_total_packages" "$CACHE_DIR/paru_completed_packages" "${_CURRENT_ATTEMPT_MARKER:-}" 2>/dev/null || true
    fi

    # 2. Get the list of all current orphans
    orphans=$(pacman -Qtdq || true)

    if [[ -n "$orphans" ]]; then
        # 3. Find dependencies of the new versions of the upgraded packages
        new_deps=""
        if [[ -n "$upgrades" ]]; then
            # Query pacman sync database for repository packages dependencies (including make dependencies if available)
            repo_deps=$(echo "$upgrades" | xargs -r pacman -Si 2>/dev/null | _parse_si_deps)
            
            # Query AUR RPC (or paru info) for AUR package dependencies and makedepends
            aur_deps=""
            # Exclude packages from official repositories, but include custom local repository targets in AUR checks
            local_repo_pattern="${PARU_WRAPPER_REPO:-}"
            if [[ -n "$local_repo_pattern" ]]; then
                official_pkgs_list=$(pacman -Sl 2>/dev/null | awk -v repo="$local_repo_pattern" '$1 != repo { print $2 }')
            else
                official_pkgs_list=$(pacman -Slq 2>/dev/null)
            fi
            aur_upgrades=$(echo "$upgrades" | grep -vFf <(echo "$official_pkgs_list") || true)
            if [[ -n "$aur_upgrades" ]]; then
                aur_deps=$(echo "$aur_upgrades" | xargs -r "${PARU_BIN:-/usr/bin/paru}" --aur -Si 2>/dev/null | _parse_si_deps)
            fi

            new_deps=$(echo -e "${repo_deps}\n${aur_deps}" | sort -u)
        fi

        # 4. Filter out any orphans that are in new_deps (plus build-deps/toolchains & target makedeps by default)
        declare -A new_deps_map=()
        while IFS= read -r dep; do
            [[ -n "$dep" ]] && new_deps_map["$dep"]=1
        done <<< "$new_deps"

        declare -A build_deps_preserve_map=()
        if ! _is_cleanup_builddeps_enabled; then
            for _bd in \
                rustup rust cargo rust-bindgen cbindgen cargo-c maturin python-setuptools-rust \
                cmake meson ninja make automake autoconf libtool pkgconf bison flex m4 patch \
                gcc clang lld llvm nasm yasm ccache extra-cmake-modules qt6-tools qt5-tools \
                wayland-protocols go ghc cabal-install stack happy alex hscolour \
                scdoc doxygen yelp-tools gtk-doc gi-docgen asciidoc asciidoctor pandoc pandoc-cli \
                python-sphinx python-build python-installer python-wheel python-setuptools \
                python-poetry-core python-hatchling python-flit-core python-scikit-build-core cython \
                swig vala gobject-introspection glslang shaderc vulkan-headers nodejs npm pnpm yarn; do
                build_deps_preserve_map["$_bd"]=1
            done

            if [ ${#targets[@]} -gt 0 ]; then
                target_repo_deps=$(LC_ALL=C pacman -Si "${targets[@]}" 2>/dev/null | _parse_si_deps)
                while IFS= read -r dep; do
                    [[ -n "$dep" ]] && new_deps_map["$dep"]=1
                done <<< "$target_repo_deps"

                for _t in "${targets[@]}"; do
                    _tname="${_t#*/}"
                    if [[ -n "${_aur_makedepends_cache["$_tname"]:-}" ]]; then
                        for dep in ${_aur_makedepends_cache["$_tname"]}; do
                            new_deps_map["$dep"]=1
                        done
                    fi
                done
            fi
            for dep in "${_target_extra_deps[@]}"; do
                [[ -n "$dep" ]] && new_deps_map["$dep"]=1
            done
        fi

        orphans_to_remove=()
        for orphan in $orphans; do
            if [[ "${new_deps_map[$orphan]+isset}" ]]; then
                msg_info "Preserving orphan package '$orphan' (will be needed by incoming updates or targets)."
            elif [[ "${build_deps_preserve_map[$orphan]+isset}" ]]; then
                msg_info "Preserving build-dep/toolchain '$orphan' (pass --cleanup-builddeps or PARU_WRAPPER_CLEANUP_BUILDDEPS=1 to remove)."
            else
                orphans_to_remove+=("$orphan")
            fi
        done
        
        # 5. Clean the remaining orphans
        if [[ ${#orphans_to_remove[@]} -gt 0 ]]; then
            echo "" >&2
            msg_info "Cleaning ${#orphans_to_remove[@]} orphaned package(s):"
            for pkg in "${orphans_to_remove[@]}"; do
                echo "  -> $pkg" >&2
            done
            if [ "$DRY_RUN" = true ]; then
                msg_info "DRY RUN: would run: sudo pacman -Rns --noconfirm -- ${orphans_to_remove[*]}"
            else
                sudo pacman -Rns --noconfirm -- "${orphans_to_remove[@]}"
            fi
        fi
    fi
fi

# 6. Execute the real paru command
purge_broken_clones
if [ -n "${PARU_WRAPPER_REPO_DB:-}" ] && [ "$DRY_RUN" != true ]; then
    ensure_repo_lock_clear "$PARU_WRAPPER_REPO_DB" || true
fi
if [ "$is_transaction" = true ]; then
    if [ "${FORCE_REBUILD:-0}" = "1" ] || [[ " $* " =~ " --rebuild " ]]; then
        if [ "$DRY_RUN" = true ]; then
            msg_info "DRY RUN: would run: /usr/bin/paru --rebuild --pacman /usr/bin/pacman-wrapper $*"
            exit_code=0
        else
            run_paru_with_clone_repair --rebuild --pacman /usr/bin/pacman-wrapper "$@"
            exit_code=$?
        fi
    else
        if [ "$DRY_RUN" = true ]; then
            msg_info "DRY RUN: would run: /usr/bin/paru --pacman /usr/bin/pacman-wrapper $*"
            exit_code=0
        else
            run_paru_with_clone_repair --pacman /usr/bin/pacman-wrapper "$@"
            exit_code=$?
        fi
    fi
else
    if [ "$DRY_RUN" = true ]; then
        msg_info "DRY RUN: would run: /usr/bin/paru $*"
        exit_code=0
    else
        run_paru_with_clone_repair "$@"
        exit_code=$?
    fi
fi

if [ "$is_transaction" = true ]; then
    # Restore pacman hooks and update database
    if [ "$hooks_disabled" = true ]; then
        msg_info "Restoring pacman hooks and updating database..."
    fi
    cleanup_hooks

    # Disable exit trap since we cleaned up explicitly
    trap - EXIT INT TERM

    # Dispatch post-transaction plugin hooks (e.g. filesystem snapshotting)
    dispatch_plugin_hooks post-transaction
fi

if [ "${exit_code:-0}" -eq 0 ] && [ ${#force_rebuild_failures[@]} -gt 0 ]; then
    msg_warn "Rebuild completed with failures for: ${force_rebuild_failures[*]}"
    exit_code=1
fi

if [ "${exit_code:-0}" -eq 0 ] && [ "$is_transaction" = true ] && [ "${hooks_disabled:-false}" = true ]; then
    # Trigger deferred plugin hooks once at the very end
    if [ ${#targets[@]} -gt 0 ]; then
        dispatch_plugin_hooks deferred-hooks "${targets[@]}"
    else
        dispatch_plugin_hooks deferred-hooks
    fi
fi

# Optional post-transaction background plugin hooks (e.g. vault sync)
if [ "${exit_code:-0}" -eq 0 ] && [ "$is_transaction" = true ]; then
    dispatch_plugin_hooks post-transaction-bg
fi

exit ${exit_code:-0}
fi