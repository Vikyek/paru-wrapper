#!/bin/bash

# paru-wrapper - wrapper around paru to handle dependency-aware orphan cleaning
# and automatic local repository DB updates.
#
# Usage:
#  /usr/bin/paru-wrapper [--dry-run] <paru args...>
#  /usr/bin/paru-wrapper --init-repo <repo_name> <repo_dir> <projects_dir>
#  /usr/bin/paru-wrapper --connect-repo <repo_name> <repo_dir> <projects_dir>

set -euo pipefail

declare -gA _aur_pkgs_cache=()

fetch_aur_metadata_batch() {
    local pkgs=("$@")
    local chunk_size=50
    local i chunk query_args curl_out

    [[ ${#pkgs[@]} -eq 0 ]] && return 0

    for ((i = 0; i < ${#pkgs[@]}; i += chunk_size)); do
        chunk=("${pkgs[@]:i:chunk_size}")
        query_args=()

        for pkg in "${chunk[@]}"; do
            query_args+=(--data-urlencode "arg[]=$pkg")
        done

        curl_out=$(curl -s -f -G "https://aur.archlinux.org/rpc/v5/info" "${query_args[@]}" 2>/dev/null) || continue

        while IFS=$'\t' read -r name version; do
            if [[ -n "$name" && "$name" != "null" ]]; then
                _aur_pkgs_cache["$name"]="$version"
            fi
        done < <(echo "$curl_out" | jq -r '.results[]? | "\(.Name)\t\(.Version)"' 2>/dev/null)
    done
}

# Initialize variables to avoid unbound variable errors
PARU_WRAPPER_REPO=""
PARU_WRAPPER_REPO_DB=""
PARU_WRAPPER_PROJECTS_DIR=""
PARU_WRAPPER_DRY_RUN="false"
PARU_WRAPPER_AUTO_UPDATE_INSTALLED="true"

# Load configurations
if [ -f "/etc/paru-wrapper.conf" ]; then
    source "/etc/paru-wrapper.conf"
fi

if [ -f "$HOME/.config/paru-wrapper/paru-wrapper.conf" ]; then
    source "$HOME/.config/paru-wrapper/paru-wrapper.conf"
fi

# Apply configurable fallbacks (Environment > Config > Defaults)
PARU_WRAPPER_REPO="${PARU_WRAPPER_REPO:-MKVPKG}"
PARU_WRAPPER_REPO_DIR="${PARU_WRAPPER_REPO_DIR:-/mnt/v/Data/makepkg/packages}"
PARU_WRAPPER_REPO_DB="${PARU_WRAPPER_REPO_DB:-${PARU_WRAPPER_REPO_DIR}/MKVPKG.db.tar.gz}"
PARU_WRAPPER_PROJECTS_DIR="${PARU_WRAPPER_PROJECTS_DIR:-${HOME:-/root}/Projects}"
PARU_WRAPPER_DRY_RUN="${PARU_WRAPPER_DRY_RUN:-false}"
PARU_WRAPPER_AUTO_UPDATE_INSTALLED="${PARU_WRAPPER_AUTO_UPDATE_INSTALLED:-true}"

# Handle initialization commands
if [ "${1:-}" = "--init-repo" ]; then
    if [ "$#" -ne 4 ]; then
        echo "Usage: paru-wrapper --init-repo <repo_name> <repo_dir> <projects_dir>"
        echo "Example: paru-wrapper --init-repo MYREPO /var/cache/pacman/myrepo ~/Projects"
        exit 1
    fi
    REPO_NAME="$2"
    REPO_DIR="$3"
    PROJ_DIR="$4"
    REPO_DB="$REPO_DIR/$REPO_NAME.db.tar.gz"

    mkdir -p "$REPO_DIR"
    mkdir -p "$PROJ_DIR"

    # Initialize empty repo if it doesn't exist
    if [ ! -f "$REPO_DB" ]; then
        # Create a dummy package just to initialize the db, then remove it
        DUMMY_DIR=$(mktemp -d)
        cat << 'EOF' > "$DUMMY_DIR/PKGBUILD"
pkgname=dummy
pkgver=1
pkgrel=1
pkgdesc="Dummy package"
arch=('any')
license=('GPL')
EOF
        (cd "$DUMMY_DIR" && makepkg -s --noconfirm >/dev/null 2>&1 || true)
        repo-add "$REPO_DB" "$DUMMY_DIR/dummy-1-1-any.pkg.tar.zst" >/dev/null 2>&1 || true
        repo-remove "$REPO_DB" dummy >/dev/null 2>&1 || true
        rm -rf "$DUMMY_DIR"
        echo "Initialized empty repository at $REPO_DB"
    fi

    CONFIG_DIR="$HOME/.config/paru-wrapper"
    mkdir -p "$CONFIG_DIR"

    cat << EOF > "$CONFIG_DIR/paru-wrapper.conf"
PARU_WRAPPER_REPO="$REPO_NAME"
PARU_WRAPPER_REPO_DB="$REPO_DB"
PARU_WRAPPER_PROJECTS_DIR="$PROJ_DIR"
EOF
    echo "Configuration written to $CONFIG_DIR/paru-wrapper.conf"
    echo ""
    echo "To use this repository, please add the following to /etc/pacman.conf:"
    echo ""
    echo "[$REPO_NAME]"
    echo "SigLevel = Optional TrustAll"
    echo "Server = file://$REPO_DIR"
    echo ""
    exit 0
fi

if [ "${1:-}" = "--connect-repo" ]; then
    if [ "$#" -ne 4 ]; then
        echo "Usage: paru-wrapper --connect-repo <repo_name> <repo_dir> <projects_dir>"
        echo "Example: paru-wrapper --connect-repo MYREPO /mnt/shared/myrepo ~/Projects"
        exit 1
    fi
    REPO_NAME="$2"
    REPO_DIR="$3"
    PROJ_DIR="$4"
    REPO_DB="$REPO_DIR/$REPO_NAME.db.tar.gz"

    CONFIG_DIR="$HOME/.config/paru-wrapper"
    mkdir -p "$CONFIG_DIR"

    cat << EOF > "$CONFIG_DIR/paru-wrapper.conf"
PARU_WRAPPER_REPO="$REPO_NAME"
PARU_WRAPPER_REPO_DB="$REPO_DB"
PARU_WRAPPER_PROJECTS_DIR="$PROJ_DIR"
EOF
    echo "Configuration written to $CONFIG_DIR/paru-wrapper.conf"
    echo ""
    echo "To connect to this repository, please add the following to /etc/pacman.conf:"
    echo ""
    echo "[$REPO_NAME]"
    echo "SigLevel = Optional TrustAll"
    echo "Server = file://$REPO_DIR"
    echo ""
    exit 0
fi

# Parse a --dry-run flag (remove it from args passed to paru)
DRY_RUN="$PARU_WRAPPER_DRY_RUN"
POSITIONAL_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n)
            DRY_RUN=true
            ;;
        *)
            POSITIONAL_ARGS+=("$arg")
            ;;
    esac
done
set -- "${POSITIONAL_ARGS[@]}"

# Safely clean up any stale null symlinks from a previously interrupted transaction
for hook in 05-snap-pac-pre.hook zz-snap-pac-post.hook paru-completion-update.hook rebuild-check.hook; do
    if [ -L "/etc/pacman.d/hooks/$hook" ] && [ "$(readlink "/etc/pacman.d/hooks/$hook")" = "/dev/null" ]; then
        echo "[paru-wrapper] Warning: Detected stale disabled hook '$hook' from a previous run. Restoring..." >&2
        sudo rm -f "/etc/pacman.d/hooks/$hook"
    fi
done

# Only run orphan cleaning if we are doing a system upgrade or installing/upgrading packages.
is_transaction=false
if [ $# -eq 0 ]; then
    is_transaction=true
    set -- "-Syu"
fi

for arg in "$@"; do
    if [[ "$arg" =~ ^-S[a-zA-Z]*$ ]]; then
        if [[ ! "$arg" =~ [silgpq] ]]; then
            is_transaction=true
            break
        fi
    elif [[ "$arg" =~ ^-U[a-zA-Z]*$ ]]; then
        is_transaction=true
        break
    fi
done

if [ "$is_transaction" = true ]; then
    # Detect if we are running in an anneal rebuild session
    is_anneal=false
    curr_pid=$$
    # Performance Optimization: Traverse process tree using native bash reads from /proc
    # instead of spawning `ps` and `tr` in a loop. Eliminates O(N) process forks and
    # speeds up is_anneal detection from ~50ms per iteration to <1ms.
    while [ -n "$curr_pid" ] && [ "$curr_pid" -ne 1 ]; do
        read -r proc_name < "/proc/$curr_pid/comm" 2>/dev/null || break
        if [ "$proc_name" = "anneal" ]; then
            is_anneal=true
            break
        fi
        read -r stat_line < "/proc/$curr_pid/stat" 2>/dev/null || break
        # Extract everything after the last parenthesis to safely skip process names with spaces/parens
        stat_tail="${stat_line##*)}"
        if read -r _ ppid _ <<< "$stat_tail"; then
            curr_pid="$ppid"
        else
            break
        fi
    done

    hooks_disabled=false
    CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/paru-wrapper"
    mkdir -p "$CACHE_DIR"

    if [ "$is_anneal" = true ] || [ "${FORCE_REBUILD:-0}" = "1" ]; then
        # Disable selected hooks to prevent snapper/completion/rebuild-check spam during intermediate package installations
        echo "[paru-wrapper] Temporarily disabling redundant hooks..." >&2
        sudo ln -sf /dev/null /etc/pacman.d/hooks/05-snap-pac-pre.hook
        sudo ln -sf /dev/null /etc/pacman.d/hooks/zz-snap-pac-post.hook
        sudo ln -sf /dev/null /etc/pacman.d/hooks/paru-completion-update.hook
        sudo ln -sf /dev/null /etc/pacman.d/hooks/rebuild-check.hook
        hooks_disabled=true
    fi

    start_marker=$(mktemp)

    cleanup_hooks() {
        # Restore pacman hooks
        if [ "$hooks_disabled" = true ]; then
            sudo rm -f /etc/pacman.d/hooks/05-snap-pac-pre.hook \
                       /etc/pacman.d/hooks/zz-snap-pac-post.hook \
                       /etc/pacman.d/hooks/paru-completion-update.hook \
                       /etc/pacman.d/hooks/rebuild-check.hook 2>/dev/null || true
        fi
        rm -f "$CACHE_DIR/paru_total_packages" "$CACHE_DIR/paru_completed_packages" 2>/dev/null || true

        # Automatically update custom repository database with any packages built during the wrapper run
        if [ -n "$PARU_WRAPPER_REPO" ] && [ -f "$start_marker" ]; then
            REPO_DIR=$(dirname "$PARU_WRAPPER_REPO_DB")
            mapfile -t new_pkgs < <(find "$REPO_DIR" -name "*.pkg.tar.zst" -newer "$start_marker" 2>/dev/null || true)
            if [ ${#new_pkgs[@]} -gt 0 ]; then
                filtered_new_pkgs=()
                for pkg_file in "${new_pkgs[@]}"; do
                    pkg_base=$(basename "$pkg_file")
                    pkg_name=$(echo "$pkg_base" | sed -E 's/-[0-9].*//')
                    if [[ ! "$pkg_name" =~ -git$ ]] && pacman -Qq "${pkg_name}-git" >/dev/null 2>&1; then
                        echo "[paru-wrapper] Skipping auto-indexing of '$pkg_base' because installed '${pkg_name}-git' takes priority." >&2
                        rm -f "$pkg_file" 2>/dev/null || true
                    else
                        filtered_new_pkgs+=("$pkg_file")
                    fi
                done
                new_pkgs=("${filtered_new_pkgs[@]}")
            fi
            if [ ${#new_pkgs[@]} -gt 0 ]; then
                echo -e "\n[paru-wrapper] Detected ${#new_pkgs[@]} newly built package(s):" >&2
                for pkg in "${new_pkgs[@]}"; do
                    echo "  -> $(basename "$pkg")" >&2
                done
                echo "[paru-wrapper] Automatically updating $PARU_WRAPPER_REPO repository database at ${PARU_WRAPPER_REPO_DB}..." >&2
                if [ "$DRY_RUN" = true ]; then
                    echo "[paru-wrapper] DRY RUN: would run: repo-add -R -w \"${PARU_WRAPPER_REPO_DB}\" \"${new_pkgs[*]}\"" >&2
                else
                    repo-add -R -w "$PARU_WRAPPER_REPO_DB" "${new_pkgs[@]}" || echo "[paru-wrapper] Warning: Failed to update repository database" >&2
                    echo "[paru-wrapper] $PARU_WRAPPER_REPO repository database updated successfully." >&2
                fi
            fi
            rm -f "$start_marker"
        fi
    }
    trap cleanup_hooks EXIT INT TERM

    # Take a single manual pre-transaction snapper snapshot
    if [ "$hooks_disabled" = true ] && command -v snapper >/dev/null; then
        if [ "$DRY_RUN" = true ]; then
            echo "[paru-wrapper] DRY RUN: would take pre-transaction snapper snapshot" >&2
            PRE_SNAP_ID=""
        else
            PRE_SNAP_ID=$(sudo snapper -c root create -d "paru-wrapper pre-transaction" -t pre -p)
            export PRE_SNAP_ID
        fi
    fi

    # Prune outdated unmodified packages from custom repo using helper script to trigger upgrades from AUR
    if [ -n "$PARU_WRAPPER_REPO" ]; then
        export PARU_WRAPPER_REPO PARU_WRAPPER_REPO_DB PARU_WRAPPER_PROJECTS_DIR PARU_WRAPPER_AUTO_UPDATE_INSTALLED
        aur_updater=()
        if [ -x "/usr/bin/update_mkvpkg_aur.py" ]; then
            aur_updater=("/usr/bin/update_mkvpkg_aur.py")
        elif [ -f "$(dirname "$0")/update_mkvpkg_aur.py" ]; then
            aur_updater=(python3 "$(dirname "$0")/update_mkvpkg_aur.py")
        fi

        if [ ${#aur_updater[@]} -gt 0 ]; then
            if [ "$DRY_RUN" = true ]; then
                echo "[paru-wrapper] DRY RUN: would run ${aur_updater[*]}" >&2
            else
                "${aur_updater[@]}" || echo "[paru-wrapper] Warning: update_mkvpkg_aur.py failed" >&2
            fi
        fi
    fi

    # Extract target packages and other arguments
    targets=()
    other_args=()
    for arg in "$@"; do
        if [[ "$arg" =~ ^- ]]; then
            other_args+=("$arg")
        else
            targets+=("$arg")
        fi
    done

    # Pre-cache official status for all packages using a single pacman invocation
    declare -A _official_pkgs_cache=()
    if [ ${#targets[@]} -gt 0 ]; then
        while read -r repo name _; do
            if [[ -n "$repo" ]] && [[ "$repo" != "$PARU_WRAPPER_REPO" ]]; then
                _official_pkgs_cache["$name"]=1
            fi
        done < <(LC_ALL=C pacman -Sl 2>/dev/null)
    fi

    # Helper to check if package is in official repos
    is_official_pkg() {
        local pkg="$1"
        if [[ "${_official_pkgs_cache["$pkg"]:-}" == 1 ]]; then
            return 0
        fi
        return 1
    }

    # Pre-fetch AUR metadata in batches
    unofficial_targets=()
    for pkg in "${targets[@]}"; do
        if ! is_official_pkg "$pkg"; then
            unofficial_targets+=("$pkg")
        fi
    done
    if [[ ${#unofficial_targets[@]} -gt 0 ]]; then
        fetch_aur_metadata_batch "${unofficial_targets[@]}"
    fi

    # Filter targets and rebuild local packages
    filtered_targets=()
    for pkg in "${targets[@]}"; do
        if is_official_pkg "$pkg"; then
            filtered_targets+=("$pkg")
        else
            if [[ -n "${_aur_pkgs_cache["$pkg"]+x}" ]]; then
                in_aur=1
            else
                in_aur=0
            fi
            if [ "$in_aur" -eq 0 ]; then
                # Local package not in AUR: rebuild from PROJECTS_DIR if available
                if [ -d "${PARU_WRAPPER_PROJECTS_DIR}/${pkg}" ] && [ -f "${PARU_WRAPPER_PROJECTS_DIR}/${pkg}/PKGBUILD" ]; then
                    echo "[paru-wrapper] Rebuilding local package '$pkg' from source in ${PARU_WRAPPER_PROJECTS_DIR}..." >&2
                    if [ "$DRY_RUN" = true ]; then
                        echo "[paru-wrapper] DRY RUN: would run: (cd \"${PARU_WRAPPER_PROJECTS_DIR}/${pkg}\" && makepkg -sfi --noconfirm)" >&2
                    else
                        if (cd "${PARU_WRAPPER_PROJECTS_DIR}/${pkg}" && makepkg -sfi --noconfirm); then
                            if command -v anneal >/dev/null; then
                                echo "[paru-wrapper] Unmarking '$pkg' in anneal rebuild queue..." >&2
                                sudo anneal unmark "$pkg" 2>/dev/null || true
                            fi
                        fi
                    fi
                else
                    echo "[paru-wrapper] Warning: Package '$pkg' is not in the AUR and no source found in ${PARU_WRAPPER_PROJECTS_DIR}. Skipping." >&2
                fi
            elif [ "${FORCE_REBUILD:-0}" = "1" ]; then
                # Force rebuild standard AUR package from source to link against new libraries
                echo "[paru-wrapper] FORCE_REBUILD active. Rebuilding AUR package '$pkg' from source..." >&2
                if [ "$DRY_RUN" = true ]; then
                    echo "[paru-wrapper] DRY RUN: would clone and rebuild '$pkg' from AUR." >&2
                else
                    build_dir=$(mktemp -d)
                    if git clone --depth 1 "https://aur.archlinux.org/$pkg.git" "$build_dir" 2>/dev/null; then
                        if (cd "$build_dir" && makepkg -sfi --noconfirm); then
                            if command -v anneal >/dev/null; then
                                echo "[paru-wrapper] Unmarking '$pkg' in anneal rebuild queue..." >&2
                                sudo anneal unmark "$pkg" 2>/dev/null || true
                            fi
                        fi
                        rm -rf "$build_dir"
                    else
                        echo "[paru-wrapper] Warning: Failed to clone '$pkg' from AUR. Passing to paru." >&2
                        rm -rf "$build_dir"
                        filtered_targets+=("$pkg")
                    fi
                fi
            else
                # Not a local modified package, must be standard AUR package
                filtered_targets+=("$pkg")
            fi
        fi
    done

    # Update command-line arguments to exclude filtered-out local packages
    set -- "${other_args[@]}" "${filtered_targets[@]}"

    if [ ${#targets[@]} -gt 0 ] && [ ${#filtered_targets[@]} -eq 0 ]; then
        echo "[paru-wrapper] All requested targets rebuilt locally. Skipping paru execution." >&2
        exit 0
    fi

    # 1. Get the list of packages to be upgraded
    upgrades=$(/usr/bin/paru -Quq 2>/dev/null || true)

    # Write total packages to paru_total_packages for progress counter
    if [[ -n "$upgrades" ]]; then
        total_pkgs=$(echo "$upgrades" | grep -v "^$" | grep -c "")
        echo "$total_pkgs" > "$CACHE_DIR/paru_total_packages"
        echo "0" > "$CACHE_DIR/paru_completed_packages"
    else
        rm -f "$CACHE_DIR/paru_total_packages" "$CACHE_DIR/paru_completed_packages" 2>/dev/null || true
    fi

    # 2. Get the list of all current orphans
    orphans=$(pacman -Qtdq || true)

    if [[ -n "$orphans" ]]; then
        # 3. Find dependencies of the new versions of the upgraded packages
        new_deps=""
        if [[ -n "$upgrades" ]]; then
            # Query pacman sync database for repository packages dependencies
            repo_deps=$(echo "$upgrades" | xargs -r pacman -Si 2>/dev/null | grep -iE '^(Depends On|Depends)[[:space:]]*:' | cut -d: -f2- | tr ' ' '\n' | sed '/^$/d; s/[<>=].*//' | sort -u || true)
            
            # Query AUR RPC (or paru info) for AUR package dependencies
            aur_deps=""
            aur_upgrades=$(echo "$upgrades" | grep -vFf <(pacman -Slq 2>/dev/null) || true)
            if [[ -n "$aur_upgrades" ]]; then
                aur_deps=$(echo "$aur_upgrades" | xargs -r /usr/bin/paru -Si 2>/dev/null | grep -iE '^(Depends On|Depends)[[:space:]]*:' | cut -d: -f2- | tr ' ' '\n' | sed '/^$/d; s/[<>=].*//' | sort -u || true)
            fi

            new_deps=$(echo -e "${repo_deps}\n${aur_deps}" | sort -u)
        fi

        # 4. Filter out any orphans that are in new_deps
        # Pad with newlines to ensure exact matching using pure bash, avoiding O(N) subprocess forks
        new_deps_padded=$'\n'"$new_deps"$'\n'
        orphans_to_remove=()
        for orphan in $orphans; do
            if [[ "$new_deps_padded" == *$'\n'"$orphan"$'\n'* ]]; then
                echo "[paru-wrapper] Preserving orphan package '$orphan' (will be needed by incoming updates)." >&2
            else
                orphans_to_remove+=("$orphan")
            fi
        done
        
        # 5. Clean the remaining orphans
        if [[ ${#orphans_to_remove[@]} -gt 0 ]]; then
            if [ -z "${NO_COLOR:-}" ]; then
                c_info='\e[1;34m'
                c_reset='\e[0m'
            else
                c_info=''
                c_reset=''
            fi
            echo -e "\n${c_info}[paru-wrapper]${c_reset} Cleaning ${#orphans_to_remove[@]} orphaned package(s):" >&2
            for pkg in "${orphans_to_remove[@]}"; do
                echo "  -> $pkg" >&2
            done
            if [ "$DRY_RUN" = true ]; then
                echo "[paru-wrapper] DRY RUN: would run: sudo pacman -Rns --noconfirm -- ${orphans_to_remove[*]}" >&2
            else
                sudo pacman -Rns --noconfirm -- "${orphans_to_remove[@]}"
            fi
        fi
    fi
fi

# 6. Execute the real paru command
if [ "$is_transaction" = true ]; then
    if [ "${FORCE_REBUILD:-0}" = "1" ] || [[ " $* " =~ " --rebuild " ]]; then
        if [ "$DRY_RUN" = true ]; then
            echo "[paru-wrapper] DRY RUN: would run: /usr/bin/paru --rebuild --pacman /usr/bin/pacman-wrapper $*" >&2
            exit_code=0
        else
            /usr/bin/paru --rebuild --pacman /usr/bin/pacman-wrapper "$@"
            exit_code=$?
        fi
    else
        if [ "$DRY_RUN" = true ]; then
            echo "[paru-wrapper] DRY RUN: would run: /usr/bin/paru --pacman /usr/bin/pacman-wrapper $*" >&2
            exit_code=0
        else
            /usr/bin/paru --pacman /usr/bin/pacman-wrapper "$@"
            exit_code=$?
        fi
    fi
else
    if [ "$DRY_RUN" = true ]; then
        echo "[paru-wrapper] DRY RUN: would run: /usr/bin/paru $*" >&2
        exit_code=0
    else
        /usr/bin/paru "$@"
        exit_code=$?
    fi
fi

if [ "$is_transaction" = true ]; then
    # Restore pacman hooks and update database
    if [ "$hooks_disabled" = true ]; then
        echo "[paru-wrapper] Restoring pacman hooks and updating database..." >&2
    fi
    cleanup_hooks

    # Disable exit trap since we cleaned up explicitly
    trap - EXIT INT TERM

    # Take a manual post-transaction snapper snapshot
    if [ "$hooks_disabled" = true ] && [[ -n "${PRE_SNAP_ID:-}" ]]; then
        if [ "$DRY_RUN" = true ]; then
            echo "[paru-wrapper] DRY RUN: would take post-transaction snapper snapshot." >&2
        else
            echo "[paru-wrapper] Taking post-transaction snapper snapshot..." >&2
            sudo snapper -c root create -d "paru-wrapper post-transaction" -t post --pre-number "$PRE_SNAP_ID"
        fi
    fi
fi

if [ "${exit_code:-0}" -eq 0 ] && [ "$is_transaction" = true ] && [ "${hooks_disabled:-false}" = true ]; then
    # Trigger deferred hook updates once at the very end
    echo "[paru-wrapper] Running deferred completion and rebuild-check hooks..." >&2
    if [ "$DRY_RUN" = true ]; then
        echo "[paru-wrapper] DRY RUN: would run paru-completion-update and rebuild-check." >&2
    else
        sudo /usr/bin/paru-completion-update || true
        # Prevent unbound variable error on $targets if it's empty
        if [ ${#targets[@]} -gt 0 ]; then
            echo "${targets[@]}" | sudo /usr/bin/rebuild-check || true
        else
            sudo /usr/bin/rebuild-check || true
        fi
    fi
fi
# Optional agy-syncvault integration
if [ "${exit_code:-0}" -eq 0 ] && [ "$is_transaction" = true ]; then
    # Resolve SUDO_USER or USER home directory safely
    INVOKING_USER="${SUDO_USER:-$USER}"
    RUN_USER_HOME=$(getent passwd "$INVOKING_USER" | cut -d: -f6)
    VAULT_SYNC_SCRIPT="${RUN_USER_HOME}/.gemini/config/scripts/auto_sync_vault.py"
    if [ -f "$VAULT_SYNC_SCRIPT" ]; then
        echo "[paru-wrapper] Triggering agy-syncvault background sync..." >&2
        runuser -u "$INVOKING_USER" -- python3 "$VAULT_SYNC_SCRIPT" >/dev/null 2>&1 &
    fi
fi

exit ${exit_code:-0}