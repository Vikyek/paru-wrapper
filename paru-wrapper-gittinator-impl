#!/usr/bin/env bash

set -eo pipefail

REAL_PARU="/usr/bin/paru"
GITTINATOR=0
HAS_NOCONFIRM=0
CLEAN_ARGS=()
NO_NOCONFIRM_ARGS=()

# ------------------------------------------------------------------------------
# 1. Argument Parsing & Flag Interception
# ------------------------------------------------------------------------------
for arg in "$@"; do
    case "$arg" in
        --gittinator)
            GITTINATOR=1
            ;;
        --noconfirm)
            HAS_NOCONFIRM=1
            CLEAN_ARGS+=("$arg")
            ;;
        *)
            CLEAN_ARGS+=("$arg")
            NO_NOCONFIRM_ARGS+=("$arg")
            ;;
    esac
done

# Re-assign positional arguments with --gittinator stripped
set -- "${CLEAN_ARGS[@]}"

# ------------------------------------------------------------------------------
# 2. Gittinator Mode Execution
# ------------------------------------------------------------------------------
if [[ $GITTINATOR -eq 1 ]]; then
    if [[ -z "${NO_COLOR:-}" && -t 2 ]]; then
        C_INFO='\e[1;34m'
        C_BOLD='\e[1m'
        C_RESET='\e[0m'
        C_BORDER='\e[1;35m'
        C_GREEN='\e[1;32m'
    else
        C_INFO=''
        C_BOLD=''
        C_RESET=''
        C_BORDER=''
        C_GREEN=''
    fi

    echo -e "${C_BORDER}==========================================================${C_RESET}" >&2
    echo -e "${C_BORDER}        --- ${C_BOLD}GITTINATOR MODE ACTIVATED${C_RESET}${C_BORDER} ---                 ${C_RESET}" >&2
    echo -e "${C_BORDER}   Converting installed packages to -git AUR variants     ${C_RESET}" >&2
    echo -e "${C_BORDER}==========================================================${C_RESET}" >&2
    echo "" >&2

    echo -e "${C_INFO}[gittinator]${C_RESET} Scanning explicitly installed packages..." >&2
    INSTALLED_PKGS=$(pacman -Qqe | grep -vE '\-(git|svn|hg|bzr)$' || true)

    if [[ -n "$INSTALLED_PKGS" ]]; then
        CANDIDATES=()
        for pkg in $INSTALLED_PKGS; do
            CANDIDATES+=("${pkg}-git")
        done

        echo -e "${C_INFO}-->${C_RESET} ${C_BOLD}Querying AUR API for available -git counterparts...${C_RESET}"
        FOUND_GIT_PKGS=()
        BATCH_SIZE=50

        for ((i=0; i<${#CANDIDATES[@]}; i+=BATCH_SIZE)); do
            BATCH=("${CANDIDATES[@]:i:BATCH_SIZE}")
            CURL_ARGS=()
            for candidate in "${BATCH[@]}"; do
                CURL_ARGS+=(--data-urlencode "arg[]=${candidate}")
            done

            RESPONSE=$(curl -G -s "https://aur.archlinux.org/rpc/v5/info" "${CURL_ARGS[@]}")
            # Performance Optimization: Offload JSON parsing and array assignment to jq and eval
            # to eliminate slow O(N) bash while-read loop overhead.
            eval "$(echo "$RESPONSE" | jq -r '.results[]? | select(.Name != null and .Name != "") | "FOUND_GIT_PKGS+=(\(.Name | @sh))"' 2>/dev/null)"
        done

        if [[ ${#FOUND_GIT_PKGS[@]} -gt 0 ]]; then
            echo ""
            echo "Found ${#FOUND_GIT_PKGS[@]} -git package replacements in AUR:"
            for pkg in "${FOUND_GIT_PKGS[@]}"; do
                echo -e "  -> ${C_BOLD}${pkg}${C_RESET}"
            done
            echo ""

            # Pacman's --noconfirm defaults to "N" on conflict prompts (Remove pkg? [y/N]).
            # When --noconfirm is passed, strip it and pipe 'yes' to auto-accept package removals.
            if [[ $HAS_NOCONFIRM -eq 1 ]]; then
                yes | "$REAL_PARU" -S --needed "${FOUND_GIT_PKGS[@]}" "${NO_NOCONFIRM_ARGS[@]}"
            else
                "$REAL_PARU" -S --needed "${FOUND_GIT_PKGS[@]}" "$@"
            fi
        else
            echo "No -git counterparts found in AUR for installed packages."
        fi
    fi

    echo ""
    echo -e "${C_INFO}-->${C_RESET} ${C_BOLD}Running full system update with VCS tracking (--devel)...${C_RESET}"
    exec "$REAL_PARU" -Syu --devel --needed "$@"
fi

# ------------------------------------------------------------------------------
# 3. Existing Wrapper Execution Pipeline
# ------------------------------------------------------------------------------
if [[ -f "$(dirname "$0")/update_mkvpkg_aur.py" ]]; then
    python3 "$(dirname "$0")/update_mkvpkg_aur.py" "$@" || true
fi

exec "$REAL_PARU" "$@"
