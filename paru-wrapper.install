post_install() {
    echo "Creating paru-wrapper symlink at ${HOME}/.local/bin/paru..."
    mkdir -p "${HOME}/.local/bin"
    ln -sf /usr/bin/paru-wrapper "${HOME}/.local/bin/paru"
    # Attempt to set ownership for the current user if available
    if [ -n "${USER:-}" ]; then
        chown "${USER}:${USER}" "${HOME}/.local/bin/paru" 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "Removing paru-wrapper symlink..."
    [ -L "${HOME}/.local/bin/paru" ] && rm -f "${HOME}/.local/bin/paru"
}
