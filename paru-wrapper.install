# shellcheck shell=bash
post_install() {
    if [ -n "${SUDO_USER:-}" ]; then
        TARGET_USER="$SUDO_USER"
        TARGET_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    else
        TARGET_USER="$USER"
        TARGET_HOME="$HOME"
    fi

    echo "Creating paru-wrapper symlink at ${TARGET_HOME}/.local/bin/paru..."
    if [ -n "${TARGET_USER:-}" ]; then
        install -d -o "${TARGET_USER}" -g "${TARGET_USER}" "${TARGET_HOME}/.local/bin" 2>/dev/null || mkdir -p "${TARGET_HOME}/.local/bin"
    else
        mkdir -p "${TARGET_HOME}/.local/bin"
    fi
    ln -sf /usr/bin/paru-wrapper "${TARGET_HOME}/.local/bin/paru"

    if [ -n "${TARGET_USER:-}" ]; then
        chown -h "${TARGET_USER}:${TARGET_USER}" "${TARGET_HOME}/.local/bin/paru" 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    if [ -n "${SUDO_USER:-}" ]; then
        TARGET_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    else
        TARGET_HOME="$HOME"
    fi

    echo "Removing paru-wrapper symlink..."
    [ -L "${TARGET_HOME}/.local/bin/paru" ] && rm -f "${TARGET_HOME}/.local/bin/paru"
}
